//==================================================================================================
// V3 Protoss gateway + robotics army policy
//
// Army targets are measured in army supply, not unit count:
//   Zealot 25%, Stalker/Dragoon slot 30%, Sentry 10%, Immortal 20%, Colossus 15%.
//
// c_PU_Stalker is intentional.  The Aiur data replaces that stable slot with the Dragoon, while
// factions without a replacement keep the standard Stalker.  No air combat unit is stocked.
//==================================================================================================

void V3ProtossGatewayRoboStock (int player, int phase) {
    AIClearStock(player);

    // V3_FAST_NATURAL_14_WORKERS_400: bank 400 minerals after fourteen
    // completed Probes and commit the natural before exposing any Gateway.
    AISetStock( player, 1, c_PB_Nexus );
    AISetStock( player, 14, c_PU_Probe );
    if (AIGetUserInt(player, 144) == 0) {
        if (AITechCount(player, c_PB_Nexus, c_techCountQueuedOrBetter) >= 2) {
            AISetUserInt(player, 144, 1);
        }
        else {
            if (AITechCount(player, c_PU_Probe, c_techCountCompleteOnly) >= 14 &&
                !AIIsExpandingOrHasExpanded(player) &&
                AIHasNearbyOpenExpansion(player) &&
                AIHasRes(player, 400, 0)) {
                AIExpand(player, AIGetTownLocation(player, c_townMain), c_PB_Nexus);
            }
            AIEnableStock(player);
            return;
        }
    }

    // Pull the shared Gateway/Robotics spine forward immediately after the
    // natural starts instead of waiting for two more Probes before Gateway.
    AISetStock( player, 1, c_PB_Pylon );
    AISetStock( player, 1, c_PB_Gateway );
    AISetStock( player, 16, c_PU_Probe );
    AISetStock( player, 18, c_PU_Probe );
    AISetStock( player, 1, c_PB_Assimilator );
    AISetStock( player, 1, c_PB_CyberneticsCore );
    AISetStock( player, 2, c_PB_Pylon );
    AISetStockFarms( player, c_PB_Pylon, c_stockNormalFarms );

    // Keep the opening strictly ordered with normal Stock entries.  UnitNext
    // with c_stockAlways is reserved for scaling after every producer exists;
    // using it here let unavailable army targets reserve the opening budget.
    AISetStock( player, 2, c_PU_Zealot );
    AISetStock( player, 2, c_PU_Stalker );
    AISetStock( player, 1, c_PU_Sentry );

    // Two-base economy and the complete production path for all five requested units.
    AISetStock( player, 24, c_PU_Probe );
    AISetStock( player, 2, c_PB_Assimilator );
    AISetStock( player, 2, c_PB_Gateway );
    AISetStock( player, 1, c_PB_RoboticsFacility );
    AISetStock( player, 1, c_PU_Immortal );
    AISetStock( player, 28, c_PU_Probe );
    AISetStock( player, 1, c_PB_RoboticsBay );
    AISetStock( player, 1, c_PB_TwilightCouncil );
    AISetStock( player, 1, c_PB_Forge );
    AISetStock( player, 1, c_PU_Colossus );
    AISetStock( player, 32, c_PU_Probe );
    AISetStock( player, 4, c_PB_Assimilator );
    AISetStock( player, 4, c_PB_Gateway );
    AISetStock( player, 2, c_PB_RoboticsFacility );

    // Opening target: 10/12/4/8/6 supply = exactly 25/30/10/20/15 percent.
    AISetStock( player, 5, c_PU_Zealot );
    AISetStock( player, 6, c_PU_Stalker );
    AISetStock( player, 2, c_PU_Sentry );
    AISetStock( player, 2, c_PU_Immortal );
    AISetStock( player, 1, c_PU_Colossus );
    AISetStock( player, 1, c_PR_WarpGateResearch );
    AISetStock( player, 1, c_PR_ZealotCharge );
    AISetStock( player, 1, c_PR_ColossusRange );
    AISetStock( player, 1, c_PR_GroundWeapons1 );
    AISetStock( player, 1, c_PR_GroundArmor1 );

    if (phase <= 0) {
        AIEnableStock(player);
        return;
    }

    // Mid game: three bases, six gases, eight Gateways and four Robotics Facilities.
    AISetStockExpand( player, c_PB_Nexus, 3 );
    AISetStockPeons( player, 24, c_PU_Probe, c_stockMinPeons, c_stockAlways );
    AISetStockUnitNext( player, 6, c_PB_Assimilator, c_stockAlways );
    AISetStockUnitNext( player, 8, c_PB_Gateway, c_stockIdle );
    AISetStockUnitNext( player, 4, c_PB_RoboticsFacility, c_stockIdle );
    AISetStockUnitNext( player, 2, c_PB_Forge, c_stockAlways );
    AISetStockPeons( player, 60, c_PU_Probe, c_stockMaxPeons, c_stockAlways );

    // Mid target: 30/36/12/24/18 supply = exactly 120 army supply at the requested ratio.
    AISetStockUnitNext( player, 15, c_PU_Zealot, c_stockAlways );
    AISetStockUnitNext( player, 18, c_PU_Stalker, c_stockAlways );
    AISetStockUnitNext( player, 6, c_PU_Sentry, c_stockAlways );
    AISetStockUnitNext( player, 6, c_PU_Immortal, c_stockAlways );
    AISetStockUnitNext( player, 3, c_PU_Colossus, c_stockAlways );
    AISetStock( player, 1, c_PR_GroundWeapons2 );
    AISetStock( player, 1, c_PR_GroundArmor2 );
    AISetStock( player, 1, c_PR_Shields1 );
    AISetStock( player, 1, c_PR_Shields2 );

    if (phase == 1) {
        AIEnableStock(player);
        return;
    }

    // Late game grows through four and five bases before committing to the six-base final stock.
    AISetStockExpand( player, c_PB_Nexus, 4 );
    AISetStockPeons( player, 72, c_PU_Probe, c_stockMaxPeons, c_stockAlways );
    AISetStockUnitNext( player, 8, c_PB_Assimilator, c_stockAlways );
    AISetStockUnitNext( player, 11, c_PB_Gateway, c_stockIdle );
    AISetStockUnitNext( player, 6, c_PB_RoboticsFacility, c_stockIdle );

    // A proportional 240-supply waypoint prevents one huge final production jump.
    AISetStockUnitNext( player, 30, c_PU_Zealot, c_stockAlways );
    AISetStockUnitNext( player, 36, c_PU_Stalker, c_stockAlways );
    AISetStockUnitNext( player, 12, c_PU_Sentry, c_stockAlways );
    AISetStockUnitNext( player, 12, c_PU_Immortal, c_stockAlways );
    AISetStockUnitNext( player, 6, c_PU_Colossus, c_stockAlways );

    AISetStockExpand( player, c_PB_Nexus, 5 );
    AISetStockPeons( player, 84, c_PU_Probe, c_stockMaxPeons, c_stockAlways );
    AISetStockUnitNext( player, 10, c_PB_Assimilator, c_stockAlways );
    AISetStockUnitNext( player, 14, c_PB_Gateway, c_stockIdle );
    AISetStockUnitNext( player, 8, c_PB_RoboticsFacility, c_stockIdle );
    AISetStockUnitNext( player, 3, c_PB_Forge, c_stockAlways );
    AISetStock( player, 1, c_PR_GroundWeapons3 );
    AISetStock( player, 1, c_PR_GroundArmor3 );
    AISetStock( player, 1, c_PR_Shields3 );

    AISetStockExpand( player, c_PB_Nexus, 6 );
    AISetStockPeons( player, 96, c_PU_Probe, c_stockMaxPeons, c_stockAlways );
    AISetStockUnitNext( player, 12, c_PB_Assimilator, c_stockAlways );
    AISetStockUnitNext( player, 16, c_PB_Gateway, c_stockIdle );
    AISetStockUnitNext( player, 10, c_PB_RoboticsFacility, c_stockIdle );

    // Late target: 90/108/36/72/54 supply = exactly 360 at 25/30/10/20/15 percent.
    AISetStockUnitNext( player, 45, c_PU_Zealot, c_stockAlways );
    AISetStockUnitNext( player, 54, c_PU_Stalker, c_stockAlways );
    AISetStockUnitNext( player, 18, c_PU_Sentry, c_stockAlways );
    AISetStockUnitNext( player, 18, c_PU_Immortal, c_stockAlways );
    AISetStockUnitNext( player, 9, c_PU_Colossus, c_stockAlways );

    AIEnableStock(player);
}

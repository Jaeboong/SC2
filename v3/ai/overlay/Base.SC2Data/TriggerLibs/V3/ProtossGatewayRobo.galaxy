//==================================================================================================
// V3 Protoss gateway + robotics army policy
//
// Army targets rise through six interleaved priority tiers.  Full targets are
// deliberately unreachable below the 800-supply ceiling, so no unit target
// becomes a practical production cap.
//
// c_PU_Stalker is intentional.  The Aiur data replaces that stable slot with the Dragoon, while
// factions without a replacement keep the standard Stalker.  No air combat unit is stocked.
//==================================================================================================

void V3ProtossGatewayRoboMinimum (int player) {
    AISetStockUnitNext(player, 1, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 2, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 1, c_PU_Sentry, c_stockAlways);
}

void V3ProtossGatewayRoboBase (int player) {
    AISetStockUnitNext(player, 3, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 4, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 1, c_PU_Sentry, c_stockAlways);
}

void V3ProtossGatewayRoboSmall (int player) {
    AISetStockUnitNext(player, 6, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 8, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 2, c_PU_Sentry, c_stockAlways);
}

void V3ProtossGatewayRoboMedium (int player) {
    AISetStockUnitNext(player, 12, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 14, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 4, c_PU_Sentry, c_stockAlways);
    AISetStockUnitNext(player, 3, c_PU_Immortal, c_stockAlways);
    AISetStockUnitNext(player, 1, c_PU_Colossus, c_stockAlways);
}

void V3ProtossGatewayRoboLarge (int player) {
    AISetStockUnitNext(player, 20, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 24, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 7, c_PU_Sentry, c_stockAlways);
    AISetStockUnitNext(player, 6, c_PU_Immortal, c_stockAlways);
    AISetStockUnitNext(player, 3, c_PU_Colossus, c_stockAlways);
}

void V3ProtossGatewayRoboFull (int player) {
    AISetStockUnitNext(player, 12, c_PU_Immortal, c_stockAlways);
    AISetStockUnitNext(player, 40, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 48, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 14, c_PU_Sentry, c_stockAlways);
    AISetStockUnitNext(player, 6, c_PU_Colossus, c_stockAlways);
    AISetStockUnitNext(player, 22, c_PU_Immortal, c_stockAlways);
    AISetStockUnitNext(player, 70, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 84, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 24, c_PU_Sentry, c_stockAlways);
    AISetStockUnitNext(player, 10, c_PU_Colossus, c_stockAlways);
    AISetStockUnitNext(player, 36, c_PU_Immortal, c_stockAlways);
    AISetStockUnitNext(player, 110, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 132, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 38, c_PU_Sentry, c_stockAlways);
    AISetStockUnitNext(player, 18, c_PU_Colossus, c_stockAlways);
    AISetStockUnitNext(player, 52, c_PU_Immortal, c_stockAlways);
    AISetStockUnitNext(player, 164, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 196, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 54, c_PU_Sentry, c_stockAlways);
    AISetStockUnitNext(player, 26, c_PU_Colossus, c_stockAlways);
    AISetStockUnitNext(player, 72, c_PU_Immortal, c_stockAlways);
    AISetStockUnitNext(player, 240, c_PU_Zealot, c_stockAlways);
    AISetStockUnitNext(player, 288, c_PU_Stalker, c_stockAlways);
    AISetStockUnitNext(player, 80, c_PU_Sentry, c_stockAlways);
    AISetStockUnitNext(player, 36, c_PU_Colossus, c_stockAlways);
}

void V3ProtossGatewayRoboStock (int player, int phase) {
    int gatewayTarget;
    int roboTarget;

    if (phase <= 0) {
        gatewayTarget = 4;
        roboTarget = 2;
    }
    else if (phase == 1) {
        gatewayTarget = 8;
        roboTarget = 4;
    }
    else {
        gatewayTarget = 16;
        roboTarget = 10;
    }

    AIClearStock(player);
    AISetTechLimitLevels(player);

    AISetStock(player, 1, c_PB_Nexus);
    AISetStock(player, V3WorkerTarget(player, 1), c_PU_Probe);
    AISetStock(player, 1, c_PB_Pylon);
    AISetStockPeons(player, V3WorkerTarget(player, 12), c_PU_Probe, c_stockMinPeons, c_stockAlways);
    AISetStockFarms(player, c_PB_Pylon, c_stockNormalFarms);

    if (AIGetUserInt(player, 144) == 0) {
        if (AITechCount(player, c_PB_Nexus, c_techCountQueuedOrBetter) >= 2) {
            AISetUserInt(player, 144, 1);
        }
        else {
            if (!AIIsExpandingOrHasExpanded(player) &&
                AIHasNearbyOpenExpansion(player) &&
                AIHasRes(player, 400, 0)) {
                AIExpand(player, AIGetTownLocation(player, c_townMain), c_PB_Nexus);
            }
            AIDefaultEconomy(player, c_PB_Nexus, c_PB_Assimilator, c_PB_Pylon, c_PU_Probe, 70, c_stockAlways);
            V3SetExpansionGasPolicy(player, c_PB_Nexus, c_PB_Assimilator);
            V3EnsureMiningExpansion(player, c_PB_Nexus, c_PB_Nexus, 400, 6);
            return;
        }
    }

    V3ProtossGatewayRoboMinimum(player);
    AISetStockPeons(player, V3WorkerTarget(player, 24), c_PU_Probe, c_stockMinPeons, c_stockAlways);
    V3ProtossGatewayRoboBase(player);
    AIDefaultEconomy(player, c_PB_Nexus, c_PB_Assimilator, c_PB_Pylon, c_PU_Probe, 70, c_stockAlways);
    V3ProtossGatewayRoboSmall(player);

    AISetStockUnitNext(player, 1, c_PB_Gateway, c_stockAlways);
    AISetStockUnitNext(player, 1, c_PB_CyberneticsCore, c_stockAlways);
    AISetStockUnitNext(player, 1, c_PB_RoboticsFacility, c_stockAlways);
    AISetStockUnitNext(player, 1, c_PB_RoboticsBay, c_stockAlways);
    AISetStockUnitNext(player, 1, c_PB_TwilightCouncil, c_stockAlways);
    // 201 과 같은 계단식 전역 생산 목표.  사용자 실측에서 "관문 1개·로보 1개"로
    // 고정된 슬롯이 이 빌드였다(2026-07-27, 2v2 4확장).  근거는 ProtossGateway.
    V3ProtossProductionRung(player, 2, gatewayTarget, c_PB_Gateway);
    V3ProtossProductionRung(player, 2, roboTarget, c_PB_RoboticsFacility);
    V3EnsureProtossExpansionPower(player);
    V3SetProtossTownProduction(player, gatewayTarget, c_PB_Gateway);
    V3SetProtossTownProduction(player, roboTarget, c_PB_RoboticsFacility);

    V3ProtossGatewayRoboMedium(player);
    V3ProtossProductionRung(player, 4, gatewayTarget, c_PB_Gateway);
    V3ProtossProductionRung(player, 3, roboTarget, c_PB_RoboticsFacility);
    V3ProtossUpgradeStock(player, 202);
    V3ProtossGatewayRoboLarge(player);
    V3ProtossProductionRung(player, 8, gatewayTarget, c_PB_Gateway);
    V3ProtossProductionRung(player, 5, roboTarget, c_PB_RoboticsFacility);

    // V3 has no separate Protoss defense stock call; preserve that policy.
    AISetStockUnitNext(player, gatewayTarget, c_PB_Gateway, c_stockIdle);
    AISetStockUnitNext(player, roboTarget, c_PB_RoboticsFacility, c_stockIdle);
    V3ProtossGatewayRoboFull(player);

    V3SetExpansionGasPolicy(player, c_PB_Nexus, c_PB_Assimilator);
    V3EnsureMiningExpansion(player, c_PB_Nexus, c_PB_Nexus, 400, 6);
}

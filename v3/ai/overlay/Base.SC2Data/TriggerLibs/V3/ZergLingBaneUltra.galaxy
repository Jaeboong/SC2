//==================================================================================================
// V3 Zerg Ling/Bane/Ultra policy
//
// The three upstream phase functions stay intact, but economy, supply, and
// army use independent stock tracks.  In particular, never put an unreachable
// army total ahead of Drone, Overlord, or tech milestones in the serial list.
//==================================================================================================

fixed[16] gv_v3LingBaneUltraTechDeadline;

bool V3ZergLingBaneUltraOpen (int player) {
    AIClearStock(player);

    // Continuous economy and supply tracks.
    AISetStockPeons( player, V3WorkerTarget(player, 32), c_ZU_Drone, c_stockMaxPeons, c_stockAlways );
    AISetStockFarms( player, c_ZU_Overlord_Alias, c_stockNormalFarms );

    // Serial stock is reserved for prerequisites and upgrades.
    AISetStock( player, 1, c_ZB_Hatchery_Alias );
    AISetStock( player, 1, c_ZB_SpawningPool );
    AISetStock( player, 1, c_ZB_Extractor );
    AISetStock( player, 1, c_ZB_BanelingNest );
    AISetStock( player, 1, c_ZB_EvolutionChamber );
    AISetStock( player, 1, c_ZR_ZerglingSpeed );
    AISetStock( player, 1, c_ZR_MeleeAttacks1 );
    AISetStock( player, 1, c_ZR_GroundCarapace1 );

    // Parallel, unbounded Ling/Bane production tracks.
    AISetStockUnitNext( player, 18, c_ZU_Zergling, c_stockAlways );
    AISetStockUnitNext( player, 8, c_ZU_Baneling, c_stockAlways );
    AISetStockUnitNext( player, 30, c_ZU_Zergling, c_stockAlways );
    AISetStockUnitNext( player, 16, c_ZU_Baneling, c_stockAlways );
    AISetStockUnitNext( player, 200, c_ZU_Zergling, c_stockAlways );
    AISetStockUnitNext( player, 140, c_ZU_Baneling, c_stockAlways );
    AISetStockUnitNext( player, 2, c_ZU_Queen, c_stockAlways );

    ZergBasicDefenseStock(player);
    ZergHDEmergencyDetectionAntiAir(player);
    ZergHDDefaultExtraStock(player);
    V3SetZergMainMacroHatcheries(player, 1);
    // 302는 나머지 3경로(저그 301·테란·플토)와 달리 네이티브 경제 드라이버가
    // 빠져 있어 확장 타운에 가스(추출장)를 못 지었다.  301과 동일한 형태로
    // 추가 — 일꾼/공급/확장 가스를 네이티브가 처리하고 아래 독립 트랙은 보조로
    // 유지(301에서 검증된 공존).  V3.6 병력 트랙 무회귀는 프로브로 확인.
    AIDefaultEconomy(player, c_ZB_Hatchery_Alias, c_ZB_Extractor, c_ZU_Overlord, c_ZU_Drone, V3MiningWorkerCapacity(player), c_stockAlways);
    V3SetExpansionGasPolicy(player, c_ZB_Hatchery_Alias, c_ZB_Extractor);
    V3EnsureMiningExpansion(player, c_ZB_Hatchery_Alias, c_ZB_Hatchery, 300, c_townMax);

    AIEnableStock(player);

    AIScoutingEnableWithPreReq(player, 12, c_ZU_Drone, 1, c_ZU_Zergling, c_techCountCompleteOnly);
    V3SetWaveTargets(player, c_ZU_Zergling, 5, V3WaveSupplyForPhase(0), 6);

    // The upstream opening normally begins immediately.  V3 deliberately
    // spends the first 300 minerals on a natural, so retain this upstream
    // stock list until its own final Drone and Baneling milestones exist
    // rather than switching at the original absolute 360-second deadline.
    if (AITechCount(player, c_ZU_Drone, c_techCountCompleteOnly) < 24 ||
        AITechCount(player, c_ZU_Baneling, c_techCountInProgressOrBetter) < 4) {
        return false;
    }

    return true;
}

void V3LingBaneMorphUltralisks (int player) {
    unitgroup larvae;
    unit larva;
    order ultraliskMorphOrder;
    int larvaIndex;
    int idleLarvaCount;
    int ultraliskMorphLimit;
    int ultraliskMorphIssued;

    if (AITechCount(player, c_ZB_UltraliskCavern, c_techCountCompleteOnly) < 1) {
        return;
    }
    larvae = UnitGroup("Larva", player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    idleLarvaCount = 0;
    larvaIndex = UnitGroupCount(larvae, c_unitCountAlive);
    for (;; larvaIndex -= 1) {
        larva = UnitGroupUnitFromEnd(larvae, larvaIndex);
        if (larva == null) {
            break;
        }
        if (UnitOrderCount(larva) == 0) {
            idleLarvaCount += 1;
        }
    }
    ultraliskMorphLimit = idleLarvaCount - 3;
    if (ultraliskMorphLimit > 4) {
        ultraliskMorphLimit = 4;
    }
    if (ultraliskMorphLimit > 0) {
        ultraliskMorphOrder = Order(AbilityCommand("LarvaTrain", 6));
        ultraliskMorphIssued = 0;
        larvaIndex = UnitGroupCount(larvae, c_unitCountAlive);
        for (;; larvaIndex -= 1) {
            larva = UnitGroupUnitFromEnd(larvae, larvaIndex);
            if (larva == null || ultraliskMorphIssued >= ultraliskMorphLimit) {
                break;
            }
            if (UnitOrderCount(larva) != 0) {
                continue;
            }
            if (UnitOrderIsValid(larva, ultraliskMorphOrder)) {
                UnitIssueOrder(larva, ultraliskMorphOrder, c_orderQueueAddToEnd);
                ultraliskMorphIssued += 1;
            }
        }
    }
}

// 라바가 30개+ 쌓여도 멜리 Stock 엔진이 틱당 소수만 소비하는 문제(§85~89에서
// P15에 대해 실측된 것과 동일)를 플레이어 링/베인 빌드에서도 끊는다.  울트라
// 전용이던 직접 라바 모프를 링/바퀴/히드라로 일반화하고, 저글링→맹독충 모프까지
// 추가한다.  Stock 트랙은 그대로 두고(공존 — §V3.6 검증 패턴) 유휴 라바를 즉시
// 병력으로 전환하는 보조 배수로다.  인덱스는 벤더 LarvaTrain InfoArray(TrainN→N-1)
// 실측: 저글링 1, 히드라 3, 바퀴 9(울트라 6은 위 별도 함수).  맹독충은 라바가
// 아니라 저글링 CAbilMorph "MorphToBaneling"(Execute=0, UpgradeToHive와 동일 구조).
void V3LingBaneMorphArmy (int player) {
    unitgroup larvae;
    unit larva;
    unitgroup lings;
    unit ling;
    order lingOrder;
    order roachOrder;
    order hydraOrder;
    order banelingOrder;
    int index;
    int idleLarvaCount;
    int morphBudget;
    int morphIssued;
    int rotation;
    int lingCount;
    int banelingIssued;
    bool hasRoach;
    bool hasHydra;
    bool hasBaneling;

    lingOrder = Order(AbilityCommand("LarvaTrain", 1));
    roachOrder = Order(AbilityCommand("LarvaTrain", 9));
    hydraOrder = Order(AbilityCommand("LarvaTrain", 3));
    hasRoach = AITechCount(player, c_ZB_RoachWarren, c_techCountCompleteOnly) >= 1;
    hasHydra = AITechCount(player, c_ZB_HydraliskDen, c_techCountCompleteOnly) >= 1;
    hasBaneling = AITechCount(player, c_ZB_BanelingNest, c_techCountCompleteOnly) >= 1;

    // (1) 유휴 라바 → 링/바퀴/히드라 라운드로빈.  드론/오버로드용 3마리는 항상
    //     남긴다(§92).  자금/공급 부족은 UnitOrderIsValid가 자동 차단한다.
    larvae = UnitGroup("Larva", player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    idleLarvaCount = 0;
    index = UnitGroupCount(larvae, c_unitCountAlive);
    for (;; index -= 1) {
        larva = UnitGroupUnitFromEnd(larvae, index);
        if (larva == null) {
            break;
        }
        if (UnitOrderCount(larva) == 0) {
            idleLarvaCount += 1;
        }
    }
    morphBudget = idleLarvaCount - 3;
    morphIssued = 0;
    rotation = 0;
    if (morphBudget > 0) {
        index = UnitGroupCount(larvae, c_unitCountAlive);
        for (;; index -= 1) {
            larva = UnitGroupUnitFromEnd(larvae, index);
            if (larva == null || morphIssued >= morphBudget) {
                break;
            }
            if (UnitOrderCount(larva) != 0) {
                continue;
            }
            // 선호 타입(로테이션 링/바퀴/히드라)을 먼저, 자금 부족 시 링으로 폴백.
            if (rotation == 1 && hasRoach && UnitOrderIsValid(larva, roachOrder)) {
                UnitIssueOrder(larva, roachOrder, c_orderQueueAddToEnd);
            }
            else if (rotation == 2 && hasHydra && UnitOrderIsValid(larva, hydraOrder)) {
                UnitIssueOrder(larva, hydraOrder, c_orderQueueAddToEnd);
            }
            else if (UnitOrderIsValid(larva, lingOrder)) {
                UnitIssueOrder(larva, lingOrder, c_orderQueueAddToEnd);
            }
            else if (hasRoach && UnitOrderIsValid(larva, roachOrder)) {
                UnitIssueOrder(larva, roachOrder, c_orderQueueAddToEnd);
            }
            else if (hasHydra && UnitOrderIsValid(larva, hydraOrder)) {
                UnitIssueOrder(larva, hydraOrder, c_orderQueueAddToEnd);
            }
            else {
                continue;
            }
            morphIssued += 1;
            rotation += 1;
            if (rotation >= 3) {
                rotation = 0;
            }
        }
    }

    // (2) 저글링 → 맹독충.  전량 전환 방지: 저글링이 12기 이상일 때 유휴 저글링만
    //     틱당 최대 3기 모프해 링/베인 혼합을 유지한다(교전 중 저글링은 건드리지
    //     않도록 UnitOrderCount == 0 만 대상).
    if (hasBaneling) {
        lingCount = AITechCount(player, c_ZU_Zergling, c_techCountCompleteOnly);
        if (lingCount >= 12) {
            banelingOrder = Order(AbilityCommand("MorphToBaneling", 0));
            lings = UnitGroup("Zergling", player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
            banelingIssued = 0;
            index = UnitGroupCount(lings, c_unitCountAlive);
            for (;; index -= 1) {
                ling = UnitGroupUnitFromEnd(lings, index);
                if (ling == null || banelingIssued >= 3) {
                    break;
                }
                if (UnitOrderCount(ling) != 0) {
                    continue;
                }
                if (UnitOrderIsValid(ling, banelingOrder)) {
                    UnitIssueOrder(ling, banelingOrder, c_orderQueueAddToEnd);
                    banelingIssued += 1;
                }
            }
        }
    }
}

void V3ZergResearchRaptor (int player) {
    unitgroup pools;
    unit pool;
    order researchOrder;

    // 산란못이 있어야 아무 리서치도 발주 가능.
    if (AITechCount(player, c_ZB_SpawningPool, c_techCountCompleteOnly) < 1) {
        return;
    }
    pools = UnitGroup("SpawningPool", player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    pool = UnitGroupUnitFromEnd(pools, UnitGroupCount(pools, c_unitCountAlive));
    if (pool == null) {
        return;
    }

    // (1) 아드레날린: Hive 완성 후에만 연구 가능(멜리 규칙). 스톡이 못 잡아서 직접 발주.
    //     비용 200/200. 이미 큐/완료면 스킵. link_index 0 로 추정(메타볼릭=1 실측 → 아드레날린=0)
    //     — B 단계 라이브 덤프로 재확인해서 틀리면 바로잡을 것.
    if (AITechCount(player, c_ZR_ZerglingHaste, c_techCountQueuedOrBetter) < 1 &&
        AITechCount(player, c_ZB_Hive, c_techCountCompleteOnly) >= 1 &&
        AIHasRes(player, 200, 200)) {
        researchOrder = Order(AbilityCommand("SpawningPoolResearch", 0));
        if (UnitOrderIsValid(pool, researchOrder)) {
            UnitIssueOrder(pool, researchOrder, c_orderQueueAddToEnd);
        }
        return;
    }

    // (2) 랩터: 사용자 지시 — 아드레날린 "완료" 후. 이미 큐/완료면 스킵. Lair 또는 Hive 필요.
    //     비용 100/100. link_index 9 로 추정(roster InfoArray Research10, 규약 N-1)
    //     — 마찬가지로 라이브 덤프로 재확인.
    if (AITechCount(player, c_ZR_ZerglingHaste, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, "SC2TeamRaptorEvolution", c_techCountQueuedOrBetter) < 1 &&
        (AITechCount(player, c_ZB_Lair_Alias, c_techCountCompleteOnly) >= 1 ||
         AITechCount(player, c_ZB_Hive, c_techCountCompleteOnly) >= 1) &&
        AIHasRes(player, 100, 100)) {
        researchOrder = Order(AbilityCommand("SpawningPoolResearch", 9));
        if (UnitOrderIsValid(pool, researchOrder)) {
            UnitIssueOrder(pool, researchOrder, c_orderQueueAddToEnd);
        }
    }
}

void V3EnsureLingBaneUltraTech (int player) {
    unitgroup candidates;
    unit lair;
    order hiveOrder;
    point townPoint;

    if (AIGetTime() < gv_v3LingBaneUltraTechDeadline[player]) {
        return;
    }

    townPoint = AIGetTownLocation(player, c_townMain);

    // Hive is the highest-priority step: an existing completed pit makes the
    // Lair morph deterministic without taking a Drone away from macro.
    if (AITechCount(player, c_ZB_InfestationPit, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_ZB_Hive, c_techCountInProgressOrBetter) < 1 &&
        AIHasRes(player, 200, 150)) {
        candidates = UnitGroup("Lair", player, RegionCircle(townPoint, 22.0), UnitFilter(0, 0, 0, 0), 0);
        lair = UnitGroupUnitFromEnd(candidates, UnitGroupCount(candidates, c_unitCountAlive));
        if (lair != null) {
            hiveOrder = Order(AbilityCommand("UpgradeToHive", 0));
            if (UnitOrderIsValid(lair, hiveOrder)) {
                UnitIssueOrder(lair, hiveOrder, c_orderQueueReplace);
                gv_v3LingBaneUltraTechDeadline[player] = AIGetTime() + 30.0;
                return;
            }
        }
    }

    if (AITechCount(player, c_ZB_Lair_Alias, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_ZB_InfestationPit, c_techCountInProgressOrBetter) < 1 &&
        AIHasRes(player, 100, 100)) {
        AIBuild(player, c_makePriorityTown, AIGetMainTown(player), c_ZB_InfestationPit, 1, c_makeNoFlags);
        gv_v3LingBaneUltraTechDeadline[player] = AIGetTime() + 30.0;
        return;
    }

    if (AITechCount(player, c_ZB_Hive, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_ZB_UltraliskCavern, c_techCountInProgressOrBetter) < 1 &&
        AIHasRes(player, 150, 200)) {
        AIBuild(player, c_makePriorityTown, AIGetMainTown(player), c_ZB_UltraliskCavern, 1, c_makeNoFlags);
        gv_v3LingBaneUltraTechDeadline[player] = AIGetTime() + 30.0;
        return;
    }
}

bool V3ZergLingBaneUltraMid (int player) {
    AIClearStock(player);

    // Continuous economy and supply tracks.
    AISetStockPeons( player, V3WorkerTarget(player, 60), c_ZU_Drone, c_stockMaxPeons, c_stockAlways );
    AISetStockFarms( player, c_ZU_Overlord_Alias, c_stockNormalFarms );

    // Serial stock is reserved for prerequisites and upgrades.
    AISetStock( player, 1, c_ZB_Hatchery_Alias );
    AISetStock( player, 1, c_ZB_SpawningPool );
    AISetStock( player, 2, c_ZB_Extractor );
    AISetStock( player, 1, c_ZB_BanelingNest );
    AISetStock( player, 1, c_ZB_RoachWarren );
    AISetStock( player, 1, c_ZB_Lair_Alias );
    AISetStock( player, 1, c_ZB_InfestationPit );
    AISetStock( player, 1, c_ZB_Hive );
    AISetStock( player, 2, c_ZB_EvolutionChamber );
    AISetStock( player, 1, c_ZB_UltraliskCavern );
    AISetStock( player, 1, c_ZR_ZerglingSpeed );
    AISetStock( player, 1, c_ZR_BanelingSpeed );
    AISetStock( player, 1, c_ZR_MeleeAttacks1 );
    AISetStock( player, 1, c_ZR_GroundCarapace1 );
    AISetStock( player, 1, c_ZR_MeleeAttacks2 );
    AISetStock( player, 1, c_ZR_GroundCarapace2 );

    // Parallel, unbounded Ling/Bane/Roach production tracks.
    AISetStockUnitNext( player, 30, c_ZU_Zergling, c_stockAlways );
    AISetStockUnitNext( player, 16, c_ZU_Baneling, c_stockAlways );
    AISetStockUnitNext( player, 8, c_ZU_Roach, c_stockAlways );
    AISetStockUnitNext( player, 300, c_ZU_Zergling, c_stockAlways );
    AISetStockUnitNext( player, 200, c_ZU_Baneling, c_stockAlways );
    AISetStockUnitNext( player, 120, c_ZU_Roach, c_stockAlways );
    AISetStockUnitNext( player, 3, c_ZU_Queen, c_stockAlways );

    AISetStock( player, 1, c_ZR_UltraliskArmor );
    AISetStockUnitNext( player, 30, c_ZU_Ultralisk, c_stockAlways );

    ZergBasicDefenseStock(player);
    ZergHDEmergencyDetectionAntiAir(player);

    if (AITechCount(player, c_ZU_Roach, c_techCountQueuedOrBetter) >= 8) {
        if (ZergHDFastExpand(player)) {
            return false;
        }
    }

    ZergHDDefaultExtraStock(player);
    V3SetZergMainMacroHatcheries(player, 2);
    // 302는 나머지 3경로(저그 301·테란·플토)와 달리 네이티브 경제 드라이버가
    // 빠져 있어 확장 타운에 가스(추출장)를 못 지었다.  301과 동일한 형태로
    // 추가 — 일꾼/공급/확장 가스를 네이티브가 처리하고 아래 독립 트랙은 보조로
    // 유지(301에서 검증된 공존).  V3.6 병력 트랙 무회귀는 프로브로 확인.
    AIDefaultEconomy(player, c_ZB_Hatchery_Alias, c_ZB_Extractor, c_ZU_Overlord, c_ZU_Drone, V3MiningWorkerCapacity(player), c_stockAlways);
    V3SetExpansionGasPolicy(player, c_ZB_Hatchery_Alias, c_ZB_Extractor);
    V3EnsureMiningExpansion(player, c_ZB_Hatchery_Alias, c_ZB_Hatchery, 300, c_townMax);

    AIEnableStock(player);
    V3EnsureLingBaneUltraTech(player);
    V3EnsureUltraliskCavernDrone(player);
    V3LingBaneMorphUltralisks(player);
    V3LingBaneMorphArmy(player);
    V3ZergResearchRaptor(player);

    V3SetWaveTargets(player, c_ZU_Zergling, 5, V3WaveSupplyForPhase(1), 6);
    if (AITechCount(player, c_ZU_Zergling, c_techCountCompleteOnly) >= 12) {
        V3SetWaveTargets(player, c_ZU_Baneling, 5, V3WaveSupplyForPhase(1), 6);
        V3SetWaveTargets(player, c_ZU_Roach, 20, V3WaveSupplyForPhase(1), 6);
    }

    // Keep the upstream final mid-game milestones as completion gates.  The
    // original 390-second shortcut assumes a one-base opening; V3's earlier
    // natural can otherwise send this build to the Ultra stage before its
    // Ling/Bane/Roach bridge has been produced.
    if (AITechCount(player, c_ZU_Drone, c_techCountCompleteOnly) < 26 ||
        AITechCount(player, c_ZU_Roach, c_techCountInProgressOrBetter) < 12 ||
        AITechCount(player, c_ZU_Baneling, c_techCountInProgressOrBetter) < 8) {
        return false;
    }

    return true;
}

bool V3ZergLingBaneUltraLate (int player) {
    AIClearStock(player);

    // Continuous economy and supply tracks.
    AISetStockPeons( player, V3WorkerTarget(player, 96), c_ZU_Drone, c_stockMaxPeons, c_stockAlways );
    AISetStockFarms( player, c_ZU_Overlord_Alias, c_stockNormalFarms );

    // Serial stock is reserved for the ground-tech chain and upgrades.
    AISetStock( player, 1, c_ZB_Hatchery_Alias );
    AISetStock( player, 1, c_ZB_SpawningPool );
    AISetStock( player, 4, c_ZB_Extractor );
    AISetStock( player, 1, c_ZB_BanelingNest );
    AISetStock( player, 1, c_ZB_RoachWarren );
    AISetStock( player, 1, c_ZB_Lair_Alias );
    AISetStock( player, 1, c_ZB_InfestationPit );
    AISetStock( player, 1, c_ZB_HydraliskDen );
    AISetStock( player, 1, c_ZB_Hive );
    AISetStock( player, 2, c_ZB_EvolutionChamber );
    AISetStock( player, 1, c_ZB_UltraliskCavern );
    AISetStock( player, 1, c_ZR_ZerglingSpeed );
    AISetStock( player, 1, c_ZR_BanelingSpeed );
    AISetStock( player, 1, c_ZR_UltraliskArmor );
    AISetStock( player, 1, c_ZR_MeleeAttacks1 );
    AISetStock( player, 1, c_ZR_GroundCarapace1 );
    AISetStock( player, 1, c_ZR_MeleeAttacks2 );
    AISetStock( player, 1, c_ZR_GroundCarapace2 );
    AISetStock( player, 1, c_ZR_MeleeAttacks3 );
    AISetStock( player, 1, c_ZR_GroundCarapace3 );

    // Parallel, unbounded late-game army tracks.
    AISetStockUnitNext( player, 470, c_ZU_Zergling, c_stockAlways );
    AISetStockUnitNext( player, 330, c_ZU_Baneling, c_stockAlways );
    AISetStockUnitNext( player, 160, c_ZU_Roach, c_stockAlways );
    AISetStockUnitNext( player, 120, c_ZU_Hydralisk, c_stockAlways );
    AISetStockUnitNext( player, 40, c_ZU_Infestor, c_stockAlways );
    AISetStockUnitNext( player, 30, c_ZU_Ultralisk, c_stockAlways );
    AISetStockUnitNext( player, 6, c_ZU_Queen, c_stockAlways );

    ZergBasicDefenseStock(player);
    ZergHDDefaultExtraStock(player);
    ZergHDEmergencyDetectionAntiAir(player);
    V3SetZergMainMacroHatcheries(player, 4);
    // 302는 나머지 3경로(저그 301·테란·플토)와 달리 네이티브 경제 드라이버가
    // 빠져 있어 확장 타운에 가스(추출장)를 못 지었다.  301과 동일한 형태로
    // 추가 — 일꾼/공급/확장 가스를 네이티브가 처리하고 아래 독립 트랙은 보조로
    // 유지(301에서 검증된 공존).  V3.6 병력 트랙 무회귀는 프로브로 확인.
    AIDefaultEconomy(player, c_ZB_Hatchery_Alias, c_ZB_Extractor, c_ZU_Overlord, c_ZU_Drone, V3MiningWorkerCapacity(player), c_stockAlways);
    V3SetExpansionGasPolicy(player, c_ZB_Hatchery_Alias, c_ZB_Extractor);
    V3EnsureMiningExpansion(player, c_ZB_Hatchery_Alias, c_ZB_Hatchery, 300, c_townMax);

    AIEnableStock(player);
    V3EnsureLingBaneUltraTech(player);
    V3EnsureUltraliskCavernDrone(player);
    V3LingBaneMorphUltralisks(player);
    V3LingBaneMorphArmy(player);
    V3ZergResearchRaptor(player);

    V3SetWaveTargets(player, c_ZU_Zergling, 5, V3WaveSupplyForPhase(2), 6);
    V3SetWaveTargets(player, c_ZU_Roach, 20, V3WaveSupplyForPhase(2), 6);
    V3SetWaveTargets(player, c_ZU_Hydralisk, 20, V3WaveSupplyForPhase(2), 6);
    V3SetWaveTargets(player, c_ZU_Ultralisk, 80, V3WaveSupplyForPhase(2), 6);

    if (AIGetTime() < 540) {
        if (AITechCount(player, c_ZU_Ultralisk, c_techCountInProgressOrBetter) < 6) {
            return false;
        }
        if (AITechCount(player, c_ZR_UltraliskArmor, c_techCountInProgressOrBetter) < 1) {
            return false;
        }
    }

    return true;
}

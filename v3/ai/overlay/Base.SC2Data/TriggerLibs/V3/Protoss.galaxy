// Match upstream ProtossAtEachTown: an established expansion receives its
// resource-side power first.  Without this, a town-local Gateway/Robotics
// request has no valid powered placement and can remain pending forever.
//
// 2026-07-27 회귀 수정: 이 함수는 예전에 bool 을 돌려주고, 호출부가 그 값으로
// 관문/로보 등록 **전체**를 건너뛰었다.  파일런이 아직 없는 확장이 하나라도
// 있으면 false 였으므로, 빈 확장이 많은 배치(사용자 실측: 2v2, 극초반 4확장)에서는
// 게이트가 거의 항상 false 가 되어 관문·로보가 앞쪽의 무조건 목표 1개에 고정됐다.
// 4v4(확장 여유가 적음)에서 정상이던 이유도 이것이다.  파워 미비 타운을 등록
// 후보에서 빼는 일은 V3SetProtossTownProduction 이 직접 하므로(완성 파일런 조건),
// 여기서는 파일런만 요청하고 생산 등록을 막지 않는다.
void V3EnsureProtossExpansionPower (int player) {
    int mainTown = AIGetMainTown(player);
    int town = 0;
    int inTown;

    while (town < c_townMax) {
        if (town != mainTown &&
            AIGetTownState(player, town) == c_townStateEstablished &&
            AIGetBuildingCountInTown(player, town, c_PB_Nexus, c_techCountCompleteOnly) >= 1) {
            inTown = AIGetBuildingCountInTown(player, town, c_PB_Pylon, c_techCountInProgressOrBetter);
            if (inTown < 1) {
                AISetStockEx(
                    player,
                    town,
                    1,
                    c_PB_Pylon,
                    c_makeExpanPower,
                    0
                );
                // 같은 타입의 활성 요청은 패스당 하나다.  가장 먼저 발견한
                // 무전력 타운에 파워 파일런을 걸고 스캔을 끝낸다.
                return;
            }
            if (inTown < 2) {
                AISetStockEx(
                    player,
                    town,
                    2,
                    c_PB_Pylon,
                    c_makeResourceDefense | c_nearDropoff,
                    0
                );
                // One completed resource-side Pylon is sufficient for the
                // local Gateway/Robotics request below.  The second Pylon is
                // a backup, not a production gate.
            }
        }
        town = town + 1;
    }
}

// 업스트림 형태의 전역 생산 시설 룽(ProtossHigh.galaxy:1237-1279 = 관문
// 2->3->4->6 을 군대 티어 사이사이에 깐다).  타운 분배와 달리 확장 개수·파워
// 상태에 좌우되지 않으므로, 타운 등록이 비어 있어도 관문이 늘어난다.
// cap 은 단계별 목표(phase target)이며 그 이상으로는 올리지 않는다.
void V3ProtossProductionRung (int player, int want, int cap, string aliasType) {
    if (want > cap) {
        want = cap;
    }
    if (want < 1) {
        return;
    }
    AISetStockUnitNext(player, want, aliasType, c_stockIdle);
}

// 확장 타운이 자체 생산 등록을 받을 자격이 있는지.  프로토스는 파일런이 완성돼
// 있어야 그 타운에 유효한 배치가 존재한다.  미완성 타운을 후보로 잡으면 패스당
// 하나뿐인 같은 타입 요청 슬롯을 배치 불가능한 요청이 물고 앉아, 다른 타운의
// 관문까지 같이 멈춘다(구 게이트가 막으려던 문제 — 이제 여기서 처리한다).
bool V3ProtossTownCanProduce (int player, int town, int mainTown) {
    if (AIGetTownState(player, town) != c_townStateEstablished) {
        return false;
    }
    if (town == mainTown) {
        return true;
    }
    return AIGetBuildingCountInTown(player, town, c_PB_Pylon, c_techCountCompleteOnly) >= 1;
}

// See V3SetTerranTownProduction.  This is deliberately town-local instead of
// a global stock target so unopened towns never reserve production buildings.
void V3SetProtossTownProduction (int player, int total, string aliasType) {
    int mainTown = AIGetMainTown(player);
    int town = 0;
    int established = 0;
    int homeTarget = total / 2;
    int remaining = total - homeTarget;
    int each;
    int extra;
    int index = 0;
    int desired;
    int inTown;
    int selectedTown = c_townInvalid;
    int selectedCount = 9999;
    int selectedDesired = 0;

    while (town < c_townMax) {
        if (town != mainTown && V3ProtossTownCanProduce(player, town, mainTown)) {
            established = established + 1;
        }
        town = town + 1;
    }
    if (established == 0) {
        // Bootstrap exactly one powered producer at the main town.  Do not
        // reserve the later expansion share until that town is Established.
        AISetStockEx(player, mainTown, 1, aliasType, c_makeDefault, 0);
        return;
    }

    each = remaining / established;
    extra = remaining - (each * established);

    // The native stock executor has one active request per same-type stock
    // pass. Select the least-filled town, but pass that town's local target.
    if (AIGetTownState(player, mainTown) == c_townStateEstablished) {
        inTown = AIGetBuildingCountInTown(player, mainTown, aliasType, c_techCountInProgressOrBetter);
        if (inTown < homeTarget) {
            selectedTown = mainTown;
            selectedCount = inTown;
            selectedDesired = homeTarget;
        }
    }
    town = 0;
    while (town < c_townMax) {
        if (town != mainTown && V3ProtossTownCanProduce(player, town, mainTown)) {
            desired = each;
            if (index < extra) {
                desired = desired + 1;
            }
            inTown = AIGetBuildingCountInTown(player, town, aliasType, c_techCountInProgressOrBetter);
            if (inTown < desired && inTown < selectedCount) {
                selectedTown = town;
                selectedCount = inTown;
                selectedDesired = desired;
            }
            index = index + 1;
        }
        town = town + 1;
    }
    if (selectedTown != c_townInvalid) {
        AISetStockEx(player, selectedTown, selectedDesired, aliasType, c_makeDefault, 0);
    }
}

// Add exactly the first unfinished level of one Forge upgrade ladder.  Keeping
// one level per stock pass prevents a distant level-three target from reserving
// resources ahead of the army tiers around this block.
bool V3ProtossAddUpgradeStep (int player, string level1, string level2, string level3) {
    if (AITechCount(player, level3, c_techCountCompleteOnly) >= 1) {
        return false;
    }
    AINewTechStock(player);
    if (AITechCount(player, level1, c_techCountCompleteOnly) < 1) {
        AITechStockAdd(level1);
    }
    else if (AITechCount(player, level2, c_techCountCompleteOnly) < 1) {
        AITechStockAdd(level2);
    }
    else if (AITechCount(player, level3, c_techCountCompleteOnly) < 1) {
        AITechStockAdd(level3);
    }
    AISetStockTechNextUnCap(player, 1000, 1000);
    return true;
}

// 단일(비체인) 업그레이드는 업스트림과 같은 형태로 곧장 올린다 — 사용자 지시,
// 2026-07-27.  업스트림 프로토스는 예외 없이 이렇게 한다:
//
//   AISetStock( player, 1, c_PR_HighTemplarPsiStorm );   // ProtossHard:51,110
//                                                        // ProtossHigh:889,1347,1435,1870
//
// 우리는 AINewTechStock + AITechStockAdd + AISetStockTechNextUnCap 체인을 거쳤다.
// 그 체인은 1->2->3 단계가 있는 공방업/실드업처럼 **여러 레벨을 순서대로** 올릴 때
// 필요한 것이고, 레벨이 하나뿐인 업그레이드에는 불필요한 우회다.  AISetStock 은
// 절대 목표라서 이미 보유했으면 자동으로 충족 처리되므로 완료 검사도 필요 없다.
//
// 사용자 라이브 관측: "플토 사이오닉 스톰 업글 안 함".  체인 경로가 사다리 뒤쪽
// (V3ProtossUpgradeStock 은 Medium 티어 뒤에 있다)에서 자금을 못 받는 것이 원인
// 후보였다.  업스트림 사용량 대비도 이 방향을 지지한다 — AISetStock 13195회 vs
// 우리 70회.  다단계 체인(V3ProtossAddUpgradeStep)은 그대로 둔다.
void V3ProtossAddSingleUpgrade (int player, string upgradeType) {
    AISetStock(player, 1, upgradeType);
}

// Shared upgrade rung for builds 201 and 202.  Aiur deliberately receives no
// Blink request: its Stalker slot is replaced by Dragoon and has no Blink.
void V3ProtossUpgradeStock (int player, int build) {
    int forgeCount = 1;
    int armyCount = 0;

    if (AIHighCurrentlyUnderHeavyAttack(player)) {
        return;
    }

    if (build == 201) {
        armyCount =
            AITechCount(player, c_PU_Zealot, c_techCountCompleteOnly) +
            AITechCount(player, c_PU_Sentry, c_techCountCompleteOnly) +
            AITechCount(player, c_PU_Archon, c_techCountCompleteOnly) +
            AITechCount(player, c_PU_HighTemplar, c_techCountCompleteOnly);
    }
    else {
        armyCount =
            AITechCount(player, c_PU_Zealot, c_techCountCompleteOnly) +
            AITechCount(player, c_PU_Stalker, c_techCountCompleteOnly) +
            AITechCount(player, c_PU_Sentry, c_techCountCompleteOnly) +
            AITechCount(player, c_PU_Immortal, c_techCountCompleteOnly) +
            AITechCount(player, c_PU_Colossus, c_techCountCompleteOnly);
    }

    if (armyCount > 0) {
        if (V3ProtossAddUpgradeStep(player, c_PR_GroundWeapons1, c_PR_GroundWeapons2, c_PR_GroundWeapons3)) {
            forgeCount += 1;
        }
        if (V3ProtossAddUpgradeStep(player, c_PR_GroundArmor1, c_PR_GroundArmor2, c_PR_GroundArmor3)) {
            forgeCount += 1;
        }
        if (V3ProtossAddUpgradeStep(player, c_PR_Shields1, c_PR_Shields2, c_PR_Shields3)) {
            forgeCount += 1;
        }
    }
    AISetStockUnitNext(player, forgeCount, c_PB_Forge, c_stockAlways);

    if (AITechCount(player, c_PB_Gateway, c_techCountCompleteOnly) >= 1) {
        V3ProtossAddSingleUpgrade(player, c_PR_WarpGateResearch);
    }
    if (AITechCount(player, c_PU_Zealot, c_techCountCompleteOnly) >= 1) {
        V3ProtossAddSingleUpgrade(player, c_PR_ZealotCharge);
    }
    if (build == 201 &&
        AITechCount(player, c_PU_HighTemplar, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_PB_TemplarArchives, c_techCountCompleteOnly) >= 1) {
        V3ProtossAddSingleUpgrade(player, c_PR_HighTemplarPsiStorm);
    }
    if (build == 202 &&
        AITechCount(player, c_PU_Colossus, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_PB_RoboticsBay, c_techCountCompleteOnly) >= 1) {
        V3ProtossAddSingleUpgrade(player, c_PR_ColossusRange);
    }
}

include "TriggerLibs/V3/ExpansionGas"
include "TriggerLibs/V3/ProtossGateway"
include "TriggerLibs/V3/ProtossGatewayRobo"

fixed[16] gv_v3ProtossTechDeadline;

// Force the Forge/Twilight/Templar tech structures via the melee AI's own
// AIBuild (Blizzard placement + Probe), gated on the real prerequisite so it
// is §83-safe, plus a per-player 30s latch. The stock requests for these are
// ignored position-dependently; AIBuild builds them where our own order does not.
void V3EnsureProtossTech (int player) {
    if (AIGetTime() < gv_v3ProtossTechDeadline[player]) {
        return;
    }
    // Forge only after a completed Cybernetics Core (keep the early army tech
    // ahead of it, per the §91 ordering lesson).
    if (AITechCount(player, c_PB_CyberneticsCore, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_PB_Forge, c_techCountInProgressOrBetter) < 1) {
        AIBuild(player, c_makePriorityTown, AIGetMainTown(player), c_PB_Forge, 1, c_makeNoFlags);
        gv_v3ProtossTechDeadline[player] = AIGetTime() + 30.0;
        return;
    }
    if (AITechCount(player, c_PB_CyberneticsCore, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_PB_TwilightCouncil, c_techCountInProgressOrBetter) < 1) {
        AIBuild(player, c_makePriorityTown, AIGetMainTown(player), c_PB_TwilightCouncil, 1, c_makeNoFlags);
        gv_v3ProtossTechDeadline[player] = AIGetTime() + 30.0;
        return;
    }
    if (AITechCount(player, c_PB_TwilightCouncil, c_techCountCompleteOnly) >= 1 &&
        AITechCount(player, c_PB_TemplarArchives, c_techCountInProgressOrBetter) < 1) {
        AIBuild(player, c_makePriorityTown, AIGetMainTown(player), c_PB_TemplarArchives, 1, c_makeNoFlags);
        gv_v3ProtossTechDeadline[player] = AIGetTime() + 30.0;
        return;
    }
}

bool V3RunProtossBuild (int player, int phase) {
    int build = AIGetUserInt(player, 142);
    if (build != 201 && build != 202) {
        return false;
    }
    if (phase == 0 && AIGetTime() >= 300) {
        AISetMainState(player, e_mainState_Mid, e_mainSubState_Build);
        phase = 1;
    }
    if (phase == 1 && AIGetTime() >= 720) {
        AISetMainState(player, e_mainState_Late, e_mainSubState_Build);
        phase = 2;
    }
    if (build == 201) {
        V3ProtossGatewayStock(player, phase);
    }
    else {
        V3ProtossGatewayRoboStock(player, phase);
    }
    V3BuildProactiveSupply(player, c_PB_Pylon);
    V3EnsureProtossTech(player);
    // 업스트림 규칙: 각 단계의 개시자는 정확히 하나, 나머지는 minSelf=999 호위다
    // (ProtossOpenTimingGateImmortalVyHd = 질럿·암살자·추적자 999 + 불멸자 1/2).
    // 개시자를 여러 종류에 걸면 "가장 낮은 문턱 하나"가 전군을 끌고 나가므로,
    // 로보는 거신 1기에 오프닝 전군이 출격하는 상태였다.  minSelf 는 단독 개시선,
    // minAlly 는 아군 교전 중 합류선이며, 어느 쪽이 발동하든 AIWaveMerge 가
    // c_waveMain 전체를 공격 웨이브로 옮긴다(유닛별 참가 명단이 아니다).
    // 후반 핵심이 아직 하나도 없으면 이전 단계의 개시자를 유지해, 개시자가
    // 존재하지 않는 구간(= 아무도 공격을 시작하지 않음)이 생기지 않게 한다.
    if (build == 201) {
        // 관문: 광전사·파수기·집정관·고위기사.  고위기사는 집정관 합체용으로
        // 본진 유휴 대기해야 하므로 의도적으로 웨이브에 등록하지 않는다.
        AISetAttackStatus(player, c_PU_Zealot, 2, 999, c_continuousMerge);
        if (phase >= 2 && AITechCount(player, c_PU_Archon, c_techCountCompleteOnly) >= 1) {
            // 후반 핵심 = 집정관
            AISetAttackStatus(player, c_PU_Sentry, 1, 999, c_continuousMerge);
            AISetAttackStatus(player, c_PU_Archon, 1, 4, c_continuousMerge);
        }
        else {
            // 초반 핵심 = 파수기
            AISetAttackStatus(player, c_PU_Archon, 1, 999, c_continuousMerge);
            AISetAttackStatus(player, c_PU_Sentry, 1, 3, c_continuousMerge);
        }
    }
    else {
        // 로보: 광전사·추적자·파수기·불멸자·거신.
        AISetAttackStatus(player, c_PU_Zealot, 2, 999, c_continuousMerge);
        AISetAttackStatus(player, c_PU_Sentry, 1, 999, c_continuousMerge);
        AISetAttackStatus(player, c_PU_Colossus, 1, 999, c_continuousMerge);
        if (phase >= 2 && AITechCount(player, c_PU_Immortal, c_techCountCompleteOnly) >= 1) {
            // 후반 핵심 = 불멸자·거신.  개시자는 하나여야 하므로 로보에서 먼저·
            // 꾸준히 나오는 불멸자가 시계를 쥐고 거신은 호위로 따라간다.
            AISetAttackStatus(player, c_PU_Stalker, 2, 999, c_continuousMerge);
            AISetAttackStatus(player, c_PU_Immortal, 1, 4, c_continuousMerge);
        }
        else {
            // 초반 핵심 = 추적자
            AISetAttackStatus(player, c_PU_Immortal, 1, 999, c_continuousMerge);
            AISetAttackStatus(player, c_PU_Stalker, 2, 8, c_continuousMerge);
        }
    }
    AIDefaultEconomy(
        player,
        c_PB_Nexus,
        c_PB_Assimilator,
        c_PB_Pylon,
        c_PU_Probe,
        70,
        c_stockAlways
    );
    V3SetExpansionGasPolicy(player, c_PB_Nexus, c_PB_Assimilator);
    V3EnsureMiningExpansion(player, c_PB_Nexus, c_PB_Nexus, 400, 6);
    AIEnableStock(player);
    return true;
}

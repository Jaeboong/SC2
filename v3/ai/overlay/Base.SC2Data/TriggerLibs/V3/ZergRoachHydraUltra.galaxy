//==================================================================================================
//  V3 Zerg ground policy: Roach / Hydralisk / Ultralisk
//
//  Core army supply pacing checkpoints culminate in unreachable final increments (no army cap).
//  Ultralisk tech begins on the phase-1 continuous track; phase 2 retains its late-game steps.
//
//  Before phase 2 the 45:40 Roach/Hydralisk weights are normalized over the two available units.
//  Phase 2 is the first phase with the full Ultralisk stock and upgrade sequence.
//  Overlords are supply providers and Queens are production support; neither is part of the core
//  army-supply target above. No air combat unit is stocked by this policy.
//==================================================================================================

fixed[16] gv_v3CavernGraceUntil;
fixed[16] gv_v3CavernDroneDeadline;

// UltraliskCavern만 멜리 AI가 Stock·AIBuild 둘 다 무시하는 게 측정됐다(18분 12슬롯
// ling/bane 미러: Hive 도달 10/12, 케이븐/울트라 0/12).  구조물이라 모프 대상이 아니라서
// "실패 시에만" 개입하는 폴백을 둔다: Hive가 완성됐는데도 유예(90s — 사용자 관측 '보통
// 하이브 후 2분 내 생김')가 지나도록 케이븐이 착공(InProgressOrBetter)조차 0이면, 그때만
// 유휴가 아닌 드론 하나에 직접 ZergBuild 7(=UltraliskCavern; 벤더 Build8 실측, N-1=7)을
// 발주한다.  멜리 AI(또는 기존 AIBuild)가 스스로 지으면 케이븐 count>0이 되어 이 블록엔
// 아예 들어오지 않는다.  주문/배치는 야생저그 하태리 재건과 동일 형식
// (AIGetBuildingPlacement + OrderTargetingPoint) — 오버레이 네이티브로 검증된 경로다.
void V3EnsureUltraliskCavernDrone (int player) {
    point townPoint;
    point buildPoint;
    order buildOrder;
    unitgroup drones;
    unit drone;
    unit chosen;
    int index;

    // Hive 없으면 대상 아님(유예 초기화).
    if (AITechCount(player, c_ZB_Hive, c_techCountCompleteOnly) < 1) {
        gv_v3CavernGraceUntil[player] = 0.0;
        return;
    }
    // 이미 착공/완성 → 정상 경로가 해냈다. 개입하지 않는다.
    if (AITechCount(player, c_ZB_UltraliskCavern, c_techCountInProgressOrBetter) >= 1) {
        return;
    }
    // 실패 판정용 유예 시작(Hive 완성 + 케이븐 0을 처음 본 시점 + 90s).
    if (gv_v3CavernGraceUntil[player] == 0.0) {
        gv_v3CavernGraceUntil[player] = AIGetTime() + 90.0;
    }
    if (AIGetTime() < gv_v3CavernGraceUntil[player]) {
        return;
    }
    // 드론이 건설지로 걸어가는 동안 매 틱 재발주하지 않도록 스로틀.
    if (AIGetTime() < gv_v3CavernDroneDeadline[player]) {
        return;
    }
    if (!AIHasRes(player, 150, 200)) {
        return;
    }

    townPoint = AIGetTownLocation(player, AIGetMainTown(player));
    buildPoint = AIGetBuildingPlacement(
        player,
        townPoint,
        c_ZB_UltraliskCavern,
        c_makeCenter | c_ignoreDanger
    );
    if (buildPoint == null || DistanceBetweenPoints(buildPoint, townPoint) > 18.0) {
        return;
    }
    buildOrder = OrderTargetingPoint(AbilityCommand("ZergBuild", 7), buildPoint);

    // 유휴 드론은 저그에서 드물다.  주문 유효성만 보고 채굴 드론 하나를 뽑아
    // 건설로 돌린다(드론은 건설 착수 시 구조물로 소모됨 = 정상 비용).
    drones = UnitGroup("Drone", player, RegionCircle(townPoint, 30.0), UnitFilter(0, 0, 0, 0), 0);
    chosen = c_nullUnit;
    index = UnitGroupCount(drones, c_unitCountAlive);
    for (;; index -= 1) {
        drone = UnitGroupUnitFromEnd(drones, index);
        if (drone == c_nullUnit) {
            break;
        }
        if (UnitOrderIsValid(drone, buildOrder)) {
            chosen = drone;
            break;
        }
    }
    if (chosen == c_nullUnit) {
        return;
    }
    UnitIssueOrder(chosen, buildOrder, c_orderQueueReplace);
    gv_v3CavernDroneDeadline[player] = AIGetTime() + 45.0;
}

// 바퀴 일부를 궤멸충(Ravager)으로 직접 모프한다.  업스트림은 AISetStock으로 하지만
// 이 빌드(울트라 병행)에선 그 방식이 0~4마리만 나와(실측 24분 12슬롯 미러), 사용자
// 지시로 맹독충과 동일한 직접 모프를 쓴다.  RoachWarren 완성 + 바퀴 12기+ 일 때 유휴
// 바퀴만 틱당 3기 모프해 바퀴/궤멸충 혼합·바퀴 풀을 유지한다(전량 전환·교전 중 바퀴
// 징발 방지).  MorphToRavager는 CAbilMorph, Execute=0(MorphToBaneling·UpgradeToHive와
// 동일 구조; 맹독충 모프로 이미 검증됨).  궤멸충은 RoachWarren 필요.
void V3RoachMorphRavagers (int player) {
    unitgroup roaches;
    unit roach;
    order ravagerOrder;
    int index;
    int roachCount;
    int issued;

    if (AITechCount(player, c_ZB_RoachWarren, c_techCountCompleteOnly) < 1) {
        return;
    }
    roachCount = AITechCount(player, c_ZU_Roach, c_techCountCompleteOnly);
    if (roachCount < 12) {
        return;
    }
    ravagerOrder = Order(AbilityCommand("MorphToRavager", 0));
    roaches = UnitGroup("Roach", player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    issued = 0;
    index = UnitGroupCount(roaches, c_unitCountAlive);
    for (;; index -= 1) {
        roach = UnitGroupUnitFromEnd(roaches, index);
        if (roach == c_nullUnit || issued >= 3) {
            break;
        }
        if (UnitOrderCount(roach) != 0) {
            continue;
        }
        if (UnitOrderIsValid(roach, ravagerOrder)) {
            UnitIssueOrder(roach, ravagerOrder, c_orderQueueAddToEnd);
            issued += 1;
        }
    }
}

void V3ZergRoachHydraUltraStock (int player, int phase) {
    int macroHatcheryTarget;
    unitgroup larvae;
    unit larva;
    order ultraliskMorphOrder;
    int larvaIndex;
    int idleLarvaCount;
    int ultraliskMorphLimit;
    int ultraliskMorphIssued;

    if (phase < 0 || phase > 2) {
        return;
    }
    if (phase == 0) {
        macroHatcheryTarget = 1;
    }
    else if (phase == 1) {
        macroHatcheryTarget = 2;
    }
    else {
        macroHatcheryTarget = 4;
    }

    AIClearStock(player);

    // Keep Drone production active while the first 300 minerals are banked.
    // The natural starts immediately once those minerals exist.
    AISetStockPeons(player, V3WorkerTarget(player, 32), c_ZU_Drone, c_stockMaxPeons, c_stockAlways);
    if (AIGetUserInt(player, 144) == 0) {
        if (AITechCount(player, c_ZB_Hatchery_Alias, c_techCountQueuedOrBetter) >= 2) {
            AISetUserInt(player, 144, 1);
        }
        else {
            if (!AIIsExpandingOrHasExpanded(player) &&
                AIHasNearbyOpenExpansion(player) &&
                AIHasRes(player, 300, 0)) {
                AIExpand(player, AIGetTownLocation(player, c_townMain), c_ZB_Hatchery);
            }
            return;
        }
    }

    // Pull the opening tech path forward as soon as the natural is committed.
    AISetStock(player, 1, c_ZB_SpawningPool);
    AISetStockFarms(player, c_ZU_Overlord, c_stockNormalFarms);
    AISetStock(player, 1, c_ZB_Extractor);
    AISetStock(player, V3WorkerTarget(player, 18), c_ZU_Drone);
    AISetStock(player, 1, c_ZB_RoachWarren);
    AISetStockUnitNext(player, 2, c_ZU_Roach, c_stockAlways);
    V3SetZergMainMacroHatcheries(player, macroHatcheryTarget);

    // The completed natural and Lair unlock the mixed Roach/Hydralisk core.
    AISetStockUnitNext(player, 2, c_ZU_Queen, c_stockAlways);
    AISetStock(player, V3WorkerTarget(player, 22), c_ZU_Drone);
    AISetStock(player, 2, c_ZB_Extractor);
    AISetStock(player, 1, c_ZB_Lair_Alias);
    AISetStockUnitNext(player, 4, c_ZU_Roach, c_stockAlways);
    AISetStock(player, 1, c_ZB_HydraliskDen_Alias);
    AISetStockUnitNext(player, 4, c_ZU_Hydralisk, c_stockAlways);
    AISetStock(player, V3WorkerTarget(player, 30), c_ZU_Drone);
    AISetStock(player, 4, c_ZB_Extractor);
    AISetStock(player, 1, c_ZB_EvolutionChamber);

    // Opening upgrades and final phase-0 core target.
    AISetStock(player, 1, c_ZR_MissileAttacks1);
    AISetStock(player, 1, c_ZR_GroundCarapace1);
    AISetStock(player, 1, c_ZR_HydraliskRange);
    AISetStock(player, 1, c_ZR_RoachSpeed);
    AISetStockUnitNext(player, 200, c_ZU_Roach, c_stockAlways);
    AISetStockUnitNext(player, 160, c_ZU_Hydralisk, c_stockAlways);
    AISetStock(player, V3WorkerTarget(player, 40), c_ZU_Drone);
    AISetStockUnitNext(player, 3, c_ZU_Queen, c_stockAlways);

    if (phase == 0) {
        return;
    }

    // Mid-game macro and an intermediate army step keep economy and combat growth balanced.
    AISetStock(player, V3WorkerTarget(player, 52), c_ZU_Drone);
    AISetStock(player, 6, c_ZB_Extractor);
    AISetStockUnitNext(player, 5, c_ZU_Queen, c_stockAlways);
    AISetStockUnitNext(player, 21, c_ZU_Roach, c_stockAlways);
    AISetStockUnitNext(player, 18, c_ZU_Hydralisk, c_stockAlways);
    AISetStock(player, 2, c_ZB_EvolutionChamber);
    AISetStock(player, 1, c_ZR_MissileAttacks2);
    AISetStock(player, 1, c_ZR_GroundCarapace2);

    // Final phase-1 core target on four bases.
    AISetStock(player, V3WorkerTarget(player, 72), c_ZU_Drone);
    AISetStock(player, 8, c_ZB_Extractor);
    AISetStockUnitNext(player, 6, c_ZU_Queen, c_stockAlways);
    AISetStockUnitNext(player, 300, c_ZU_Roach, c_stockAlways);
    AISetStockUnitNext(player, 240, c_ZU_Hydralisk, c_stockAlways);

    // v3.7 port: pull the ultralisk tech chain off the phase-2 gate so a slot stuck
    // in phase 1 still reaches Hive and Ultralisks. Continuous non-blocking track;
    // the serial UltraliskArmor upgrade stays last so it blocks nothing after it.
    AISetStockUnitNext(player, 1, c_ZB_InfestationPit, c_stockAlways);
    AISetStockUnitNext(player, 1, c_ZB_Hive, c_stockAlways);
    AISetStockUnitNext(player, 1, c_ZB_UltraliskCavern, c_stockAlways);
    AISetStock(player, 1, c_ZR_UltraliskArmor);
    AISetStockUnitNext(player, 30, c_ZU_Ultralisk, c_stockAlways);

    // 케이븐은 Stock·AIBuild 모두 무시되므로 실패 시에만 드론 직접건설로 폴백(phase>=1).
    V3EnsureUltraliskCavernDrone(player);
    // 궤멸충: 업스트림 AISetStock은 이 빌드(울트라 병행)에선 0~4만 나옴(실측) —
    // 사용자 지시로 맹독충처럼 직접 모프로 물량을 낸다.  V3SetWaveTargets로 공격 참여.
    V3RoachMorphRavagers(player);
    V3SetWaveTargets(player, c_ZU_Ravager, 30, V3WaveSupplyForPhase(phase), 6);

    if (phase == 1) {
        return;
    }

    // §87: Stock만으로는 울트라리스크를 안정적으로 만들지 못하므로, 완료된 굴이
    // 있을 때 유휴 라바에 검증된 LarvaTrain 6번 모프를 직접 발주한다.
    if (AITechCount(player, c_ZB_UltraliskCavern, c_techCountCompleteOnly) >= 1) {
        larvae = UnitGroup("Larva", player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        idleLarvaCount = 0;
        larvaIndex = UnitGroupCount(larvae, c_unitCountAlive);
        for (;; larvaIndex -= 1) {
            larva = UnitGroupUnitFromEnd(larvae, larvaIndex);
            if (larva == null) {
                break;
            }
            if (UnitOrderCount(larva) == 0) {
                idleLarvaCount += 1;
            }
        }
        ultraliskMorphLimit = idleLarvaCount - 3;
        if (ultraliskMorphLimit > 4) {
            ultraliskMorphLimit = 4;
        }
        if (ultraliskMorphLimit > 0) {
            ultraliskMorphOrder = Order(AbilityCommand("LarvaTrain", 6));
            ultraliskMorphIssued = 0;
            larvaIndex = UnitGroupCount(larvae, c_unitCountAlive);
            for (;; larvaIndex -= 1) {
                larva = UnitGroupUnitFromEnd(larvae, larvaIndex);
                if (larva == null || ultraliskMorphIssued >= ultraliskMorphLimit) {
                    break;
                }
                if (UnitOrderCount(larva) != 0) {
                    continue;
                }
                if (UnitOrderIsValid(larva, ultraliskMorphOrder)) {
                    UnitIssueOrder(larva, ultraliskMorphOrder, c_orderQueueAddToEnd);
                    ultraliskMorphIssued += 1;
                }
            }
        }
    }

    // Ultralisk prerequisites, upgrades, and stock targets intentionally begin only in phase 2.
    AISetStock(player, 1, c_ZB_InfestationPit);
    AISetStock(player, 1, c_ZB_Hive);
    AISetStock(player, 1, c_ZB_UltraliskCavern);
    AISetStock(player, 1, c_ZR_MeleeAttacks1);
    AISetStock(player, 1, c_ZR_UltraliskArmor);

    // First late-game step: 45/40/3 core units = 188 army supply.
    AISetStockUnitNext(player, 45, c_ZU_Roach, c_stockAlways);
    AISetStockUnitNext(player, 40, c_ZU_Hydralisk, c_stockAlways);
    AISetStockUnitNext(player, 3, c_ZU_Ultralisk, c_stockAlways);

    AISetStock(player, V3WorkerTarget(player, 84), c_ZU_Drone);
    AISetStock(player, 10, c_ZB_Extractor);
    AISetStockUnitNext(player, 8, c_ZU_Queen, c_stockAlways);
    AISetStock(player, 1, c_ZR_MissileAttacks3);
    AISetStock(player, 1, c_ZR_MeleeAttacks2);
    AISetStock(player, 1, c_ZR_GroundCarapace3);

    // Second late-game step: 60/54/6 core units = 264 army supply.
    AISetStockUnitNext(player, 60, c_ZU_Roach, c_stockAlways);
    AISetStockUnitNext(player, 54, c_ZU_Hydralisk, c_stockAlways);
    AISetStockUnitNext(player, 6, c_ZU_Ultralisk, c_stockAlways);

    AISetStock(player, V3WorkerTarget(player, 100), c_ZU_Drone);
    AISetStock(player, 12, c_ZB_Extractor);
    AISetStockUnitNext(player, 10, c_ZU_Queen, c_stockAlways);
    AISetStock(player, 1, c_ZR_MeleeAttacks3);

    // Unreachable final increments keep army production uncapped.
    AISetStockUnitNext(player, 470, c_ZU_Roach, c_stockAlways);
    AISetStockUnitNext(player, 380, c_ZU_Hydralisk, c_stockAlways);
    AISetStockUnitNext(player, 30, c_ZU_Ultralisk, c_stockAlways);

}

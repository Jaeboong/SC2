//--------------------------------------------------------------------------------------------------
//  V3TerranMechanicStock
//
//  Ground-only Terran mechanic policy.  Army percentages are measured in army supply, not unit
//  count: SC2TeamGoliath 35%, Cyclone 25%, Siege Tank 25%, Thor 15%.
//
//  phase 0: opening, 39 army supply (nearest integral-unit approximation)
//  phase 1: mid game, 120 army supply (exact ratio)
//  phase 2: late game, 360 army supply (exact ratio)
//--------------------------------------------------------------------------------------------------
void V3TerranMechanicStock (int player, int phase) {
    AIClearStock(player);

    // Keep SCV production active while the opening banks the first 400
    // minerals. The natural starts immediately once those minerals exist.
    AISetStock( player, 1, c_TB_CommandCenter_Alias );
    AISetStockPeons( player, 32, c_TU_SCV, c_stockMaxPeons, c_stockAlways );
    if (AIGetUserInt(player, 144) == 0) {
        if (AITechCount(player, c_TB_CommandCenter_Alias, c_techCountQueuedOrBetter) >= 2) {
            AISetUserInt(player, 144, 1);
        }
        else {
            if (!AIIsExpandingOrHasExpanded(player) &&
                AIHasNearbyOpenExpansion(player) &&
                AIHasRes(player, 400, 0)) {
                AIExpand(player, AIGetTownLocation(player, c_townMain), c_TB_CommandCenter);
            }
            AIEnableStock(player);
            return;
        }
    }

    // Open the Factory/Armory prerequisite chain as soon as the natural starts.
    AISetStockFarms( player, c_TB_SupplyDepot, c_stockNeededFarms );
    AISetStock( player, 1, c_TB_Barracks );
    AISetStock( player, 16, c_TU_SCV );
    AISetStock( player, 1, c_TB_Refinery );
    AISetStock( player, 18, c_TU_SCV );
    AISetStock( player, 1, c_TB_OrbitalCommand );
    AISetStock( player, 1, c_TB_Factory );
    AISetStock( player, 20, c_TU_SCV );
    AISetStock( player, 2, c_TB_Refinery );
    AISetStock( player, 1, c_TB_FactoryTechLab );
    AISetStock( player, 22, c_TU_SCV );
    AISetStock( player, 1, c_TB_Armory );

    // 9 supply: 4 Goliath / 2 Cyclone / 3 Tank.
    AISetStockUnitNext( player, 2, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 1, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 1, c_TU_SiegeTank, c_stockAlways );

    // Continue the two-base economy before committing to the expensive Thor tier.
    AISetStock( player, 2, c_TB_OrbitalCommand );
    AISetStock( player, 28, c_TU_SCV );
    AISetStock( player, 3, c_TB_Refinery );
    AISetStock( player, 2, c_TB_Factory );

    // 19 supply cumulative.
    AISetStockUnitNext( player, 3, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 2, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 1, c_TU_Thor, c_stockAlways );

    AISetStock( player, 32, c_TU_SCV );
    AISetStock( player, 4, c_TB_Refinery );
    AISetStock( player, 3, c_TB_Factory );
    AISetStock( player, 2, c_TB_FactoryTechLab );

    // 28 supply cumulative.
    AISetStockUnitNext( player, 5, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 3, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 2, c_TU_SiegeTank, c_stockAlways );

    AISetStock( player, 36, c_TU_SCV );

    // Opening target: 14/10/9/6 supply = 35.9/25.6/23.1/15.4 percent.
    AISetStockUnitNext( player, 7, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 5, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 3, c_TU_SiegeTank, c_stockAlways );
    AISetStockUnitNext( player, 1, c_TU_Thor, c_stockAlways );
    AISetStock( player, 1, c_TR_VehicleWeapons1 );
    AISetStock( player, 1, c_TR_MechPlating1 );

    if (phase <= 0) {
        AIEnableStock(player);
        return;
    }

    // Mid-game economy: three saturated bases feeding seven Factories.
    AISetStockExpand( player, c_TB_CommandCenter_Alias, 3 );
    AISetStock( player, 3, c_TB_OrbitalCommand );
    AISetStock( player, 48, c_TU_SCV );
    AISetStock( player, 6, c_TB_Refinery );
    AISetStock( player, 5, c_TB_Factory );
    AISetStock( player, 4, c_TB_FactoryTechLab );

    // 81 supply cumulative; this is the closest integral-unit step to the requested ratio.
    AISetStockUnitNext( player, 14, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 10, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 7, c_TU_SiegeTank, c_stockAlways );
    AISetStockUnitNext( player, 2, c_TU_Thor, c_stockAlways );

    AISetStock( player, 60, c_TU_SCV );
    AISetStock( player, 7, c_TB_Factory );
    AISetStock( player, 5, c_TB_FactoryTechLab );
    AISetStock( player, 2, c_TB_Armory );

    // Mid target: 42/30/30/18 supply = exactly 35/25/25/15 percent.
    AISetStockUnitNext( player, 21, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 15, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 10, c_TU_SiegeTank, c_stockAlways );
    AISetStockUnitNext( player, 3, c_TU_Thor, c_stockAlways );
    AISetStock( player, 1, c_TR_CycloneDamage );
    AISetStock( player, 1, c_TR_VehicleWeapons2 );
    AISetStock( player, 1, c_TR_MechPlating2 );

    if (phase == 1) {
        AIEnableStock(player);
        return;
    }

    // Late-game first macro step: four bases and enough production for 240 army supply.
    AISetStockExpand( player, c_TB_CommandCenter_Alias, 4 );
    AISetStock( player, 4, c_TB_OrbitalCommand );
    AISetStock( player, 72, c_TU_SCV );
    AISetStock( player, 8, c_TB_Refinery );
    AISetStock( player, 10, c_TB_Factory );
    AISetStock( player, 7, c_TB_FactoryTechLab );
    AISetStockUnitNext( player, 42, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 30, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 20, c_TU_SiegeTank, c_stockAlways );
    AISetStockUnitNext( player, 6, c_TU_Thor, c_stockAlways );

    // Keep adding resource pairs before the final production and army targets.
    AISetStockExpand( player, c_TB_CommandCenter_Alias, 5 );
    AISetStock( player, 5, c_TB_OrbitalCommand );
    AISetStock( player, 84, c_TU_SCV );
    AISetStock( player, 10, c_TB_Refinery );
    AISetStock( player, 13, c_TB_Factory );
    AISetStock( player, 9, c_TB_FactoryTechLab );
    AISetStock( player, 1, c_TR_VehicleWeapons3 );
    AISetStock( player, 1, c_TR_MechPlating3 );

    AISetStockExpand( player, c_TB_CommandCenter_Alias, 6 );
    AISetStock( player, 6, c_TB_OrbitalCommand );
    AISetStock( player, 96, c_TU_SCV );
    AISetStock( player, 12, c_TB_Refinery );
    AISetStock( player, 16, c_TB_Factory );
    AISetStock( player, 12, c_TB_FactoryTechLab );

    // Late target: 126/90/90/54 supply = exactly 35/25/25/15 percent.
    AISetStockUnitNext( player, 63, "SC2TeamGoliath", c_stockAlways );
    AISetStockUnitNext( player, 45, c_TU_Cyclone, c_stockAlways );
    AISetStockUnitNext( player, 30, c_TU_SiegeTank, c_stockAlways );
    AISetStockUnitNext( player, 9, c_TU_Thor, c_stockAlways );

    AIEnableStock(player);
}

//--------------------------------------------------------------------------------------------------
//  V3 Terran Bionic
//
//  Ground-only stock policy.  Army targets are measured in combat supply:
//
//    phase 0: 19 Marine + 5 Marauder + 1 Medic + 3 Siege Tank = 40 supply
//             (47.50 / 25.00 / 5.00 / 22.50 percent)
//    phase 1: 54 Marine + 15 Marauder + 3 Medic + 10 Siege Tank = 120 supply
//             (45.00 / 25.00 / 5.00 / 25.00 percent)
//    phase 2: 162 Marine + 45 Marauder + 9 Medic + 30 Siege Tank = 360 supply
//             (45.00 / 25.00 / 5.00 / 25.00 percent)
//
//  SC2TeamMedic costs two supply.  Its targets are deliberately never more than five percent of
//  the army-supply target.  This file only declares stock; it never issues a production or unit
//  order directly.
//--------------------------------------------------------------------------------------------------
void V3TerranBionicStock (int player, int phase) {
    int workerCap;
    int townTarget;
    int refineryTarget;
    int barracksTarget;
    int barracksTechLabTarget;
    int barracksReactorTarget;
    int factoryTarget;
    int factoryTechLabTarget;
    int marineTarget;
    int marauderTarget;
    int medicTarget;
    int tankTarget;
    int nonMedicSupply;
    int medicAllowedTarget;

    // Treat invalid low phases as the opening and retain the late-game policy after phase 2.
    if (phase <= 0) {
        workerCap = 45;
        townTarget = 2;
        refineryTarget = 3;
        barracksTarget = 3;
        barracksTechLabTarget = 2;
        barracksReactorTarget = 1;
        factoryTarget = 2;
        factoryTechLabTarget = 1;

        marineTarget = 19;
        marauderTarget = 5;
        medicTarget = 1;
        tankTarget = 3;
    }
    else if (phase == 1) {
        workerCap = 60;
        townTarget = 3;
        refineryTarget = 5;
        barracksTarget = 6;
        barracksTechLabTarget = 4;
        barracksReactorTarget = 2;
        factoryTarget = 4;
        factoryTechLabTarget = 3;

        marineTarget = 54;
        marauderTarget = 15;
        medicTarget = 3;
        tankTarget = 10;
    }
    else {
        workerCap = 85;
        townTarget = 6;
        refineryTarget = 11;
        barracksTarget = 14;
        barracksTechLabTarget = 8;
        barracksReactorTarget = 6;
        factoryTarget = 8;
        factoryTechLabTarget = 6;

        marineTarget = 162;
        marauderTarget = 45;
        medicTarget = 9;
        tankTarget = 30;
    }

    AIClearStock(player);

    // V3_FAST_NATURAL_14_WORKERS_400: bank 400 minerals after fourteen
    // completed SCVs and commit the natural before exposing any Barracks.
    AISetStock(player, 1, c_TB_CommandCenter_Alias);
    AISetStock(player, 14, c_TU_SCV);
    if (AIGetUserInt(player, 144) == 0) {
        if (AITechCount(player, c_TB_CommandCenter_Alias, c_techCountQueuedOrBetter) >= 2) {
            AISetUserInt(player, 144, 1);
        }
        else {
            if (AITechCount(player, c_TU_SCV, c_techCountCompleteOnly) >= 14 &&
                !AIIsExpandingOrHasExpanded(player) &&
                AIHasNearbyOpenExpansion(player) &&
                AIHasRes(player, 400, 0)) {
                AIExpand(player, AIGetTownLocation(player, c_townMain), c_TB_CommandCenter);
            }
            AIEnableStock(player);
            return;
        }
    }

    // Start the Barracks immediately after the natural is committed, then let
    // the normal economy and phase targets take over.
    AISetStockFarms(player, c_TB_SupplyDepot, c_stockNeededFarms);
    AISetStock(player, 1, c_TB_Barracks);

    // Economy, gas and staged expansion.  StockExpand gives each phase a definite base target;
    // DefaultExpansion also lets the normal AI react before mineral or gas fields are exhausted.
    AISetStockPeons(player, workerCap, c_TU_SCV, c_stockMinPeons, c_stockAlways);
    AIDefaultEconomy(
        player,
        c_TB_CommandCenter_Alias,
        c_TB_Refinery,
        c_TB_SupplyDepot,
        c_TU_SCV,
        workerCap,
        c_stockAlways
    );
    AISetStockUnitNext(player, refineryTarget, c_TB_Refinery, c_stockAlways);
    AISetStockExpand(player, c_TB_CommandCenter_Alias, townTarget);
    AIDefaultExpansion(player, c_TB_CommandCenter, 7000, 3000, c_expandVitalHard);
    AISetStockFarms(player, c_TB_SupplyDepot, c_stockNormalFarms);

    // Ground production and its prerequisites.  No air-production structure is requested.
    AISetStockUnitNext(player, barracksTarget, c_TB_Barracks, c_stockIdle);
    AISetStockUnitNext(player, barracksTechLabTarget, c_TB_BarracksTechLab, c_stockIdle);
    AISetStockUnitNext(player, barracksReactorTarget, c_TB_BarracksReactor, c_stockIdle);
    AISetStockUnitNext(player, factoryTarget, c_TB_Factory, c_stockIdle);
    AISetStockUnitNext(player, factoryTechLabTarget, c_TB_FactoryTechLab, c_stockIdle);
    AISetStockUnitNext(player, 1, c_TB_EngineeringBay, c_stockAlways);
    AISetStockUnitNext(player, 1, c_TB_Armory, c_stockAlways);

    // Core bio and tank upgrades.  Higher phases preserve prerequisite order through Stock.
    AISetStock(player, 1, c_TR_MarineStimPack);
    AISetStock(player, 1, c_TR_MarineShield);
    AISetStock(player, 1, c_TR_MarauderSlow);
    AISetStock(player, 1, c_TR_InfantryWeapons1);
    AISetStock(player, 1, c_TR_InfantryArmor1);
    AISetStock(player, 1, c_TR_VehicleWeapons1);
    AISetStock(player, 1, c_TR_MechPlating1);

    if (phase >= 1) {
        AISetStock(player, 1, c_TR_InfantryWeapons2);
        AISetStock(player, 1, c_TR_InfantryArmor2);
        AISetStock(player, 1, c_TR_VehicleWeapons2);
        AISetStock(player, 1, c_TR_MechPlating2);
    }
    if (phase >= 2) {
        AISetStockUnitNext(player, 2, c_TB_EngineeringBay, c_stockAlways);
        AISetStockUnitNext(player, 2, c_TB_Armory, c_stockAlways);
        AISetStock(player, 1, c_TR_InfantryWeapons3);
        AISetStock(player, 1, c_TR_InfantryArmor3);
        AISetStock(player, 1, c_TR_VehicleWeapons3);
        AISetStock(player, 1, c_TR_MechPlating3);
    }

    // A Medic costs two supply.  One Medic therefore requires at least 38 non-Medic army supply:
    //   2 / (38 + 2) = 5 percent.
    // Gate every newly stocked Medic on the live/in-progress non-Medic force as well as the phase
    // target.  This prevents parallel Barracks production from getting ahead of the tank quota.
    nonMedicSupply =
        AITechCount(player, c_TU_Marine, c_techCountInProgressOrBetter) +
        (2 * AITechCount(player, c_TU_Marauder, c_techCountInProgressOrBetter)) +
        (3 * AITechCount(player, c_TU_SiegeTank_Alias, c_techCountInProgressOrBetter));
    medicAllowedTarget = nonMedicSupply / 38;
    if (medicAllowedTarget < medicTarget) {
        medicTarget = medicAllowedTarget;
    }
    if (medicTarget > 0) {
        AISetStockUnitNext(player, medicTarget, "SC2TeamMedic", c_stockAlways);
    }

    // The other three allowed ground units follow the capped support target.
    // Putting Medic after the full 360-supply combat targets starved it forever
    // because StockUnitNext is ordered and casualties kept reopening earlier goals.
    AISetStockUnitNext(player, marineTarget, c_TU_Marine, c_stockAlways);
    AISetStockUnitNext(player, marauderTarget, c_TU_Marauder, c_stockAlways);
    AISetStockUnitNext(player, tankTarget, c_TU_SiegeTank, c_stockAlways);

    // Register every stock unit with the standard wave merger.  Medic follows the army as support.
    AISetAttackStatus(player, c_TU_Marine, 2, 999, c_continuousMerge);
    AISetAttackStatus(player, c_TU_Marauder, 2, 999, c_continuousMerge);
    AISetAttackStatus(player, "SC2TeamMedic", 1, 999, c_continuousMerge);
    AISetAttackStatus(player, c_TU_SiegeTank, 1, 999, c_continuousMerge);

    AIEnableStock(player);
}

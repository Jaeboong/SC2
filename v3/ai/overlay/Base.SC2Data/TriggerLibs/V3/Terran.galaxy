// Register a production-building target directly with the town stock engine.
// The main town receives at most floor(total / 2); remaining targets exist
// only after an expansion has reached the upstream Established state.
void V3SetTerranTownProduction (int player, int total, string aliasType) {
    int mainTown = AIGetMainTown(player);
    int town = 0;
    int established = 0;
    int homeTarget = total / 2;
    int remaining = total - homeTarget;
    int each;
    int extra;
    int index = 0;
    int desired;
    int inTown;
    int selectedTown = c_townInvalid;
    int selectedCount = 9999;
    int selectedDesired = 0;

    while (town < c_townMax) {
        if (town != mainTown && AIGetTownState(player, town) == c_townStateEstablished) {
            established = established + 1;
        }
        town = town + 1;
    }
    if (established == 0) {
        // There is no future-town reservation before an expansion exists,
        // but the opening still needs one real producer in the main town.
        // Keep this town-local so the normal target cannot race the later
        // distributed StockEx request in the same pass.
        AISetStockEx(player, mainTown, 1, aliasType, c_makeDefault, 0);
        return;
    }

    each = remaining / established;
    extra = remaining - (each * established);

    // Keep one same-type request per stock pass: the native executor keeps
    // only one active same-type request. Its count is the selected town's
    // local target, matching the upstream StockEx contract.
    if (AIGetTownState(player, mainTown) == c_townStateEstablished) {
        inTown = AIGetBuildingCountInTown(player, mainTown, aliasType, c_techCountInProgressOrBetter);
        if (inTown < homeTarget) {
            selectedTown = mainTown;
            selectedCount = inTown;
            selectedDesired = homeTarget;
        }
    }
    town = 0;
    while (town < c_townMax) {
        if (town != mainTown && AIGetTownState(player, town) == c_townStateEstablished) {
            desired = each;
            if (index < extra) {
                desired = desired + 1;
            }
            inTown = AIGetBuildingCountInTown(player, town, aliasType, c_techCountInProgressOrBetter);
            if (inTown < desired && inTown < selectedCount) {
                selectedTown = town;
                selectedCount = inTown;
                selectedDesired = desired;
            }
            index = index + 1;
        }
        town = town + 1;
    }
    if (selectedTown != c_townInvalid) {
        AISetStockEx(player, selectedTown, selectedDesired, aliasType, c_makeDefault, 0);
    }
}

include "TriggerLibs/V3/ExpansionGas"
include "TriggerLibs/V3/TerranBionic"
include "TriggerLibs/V3/TerranMechanic"

bool V3RunTerranBuild (int player, int phase) {
    int build = AIGetUserInt(player, 142);
    if (build != 101 && build != 102) {
        return false;
    }
    // These campaign units are connected to real producer abilities by the
    // map catalog. Register the same maker commands with Blizzard's stock
    // requirement resolver once per AI player so AISetStock can train them.
    if (AIGetUserInt(player, 143) == 0) {
        AIReqAddSpecialMaker("SC2TeamMedic", c_TB_Barracks, "BarracksTrain", 19);
        AIReqAddSpecialMaker("SC2TeamGoliath", c_TB_Factory, "FactoryTrain", 19);
        AISetUserInt(player, 143, 1);
    }
    if (phase == 0 && AIGetTime() >= 300) {
        AISetMainState(player, e_mainState_Mid, e_mainSubState_Build);
        phase = 1;
    }
    if (phase == 1 && AIGetTime() >= 720) {
        AISetMainState(player, e_mainState_Late, e_mainSubState_Build);
        phase = 2;
    }
    if (build == 101) {
        V3TerranBionicStock(player, phase);
        // Supply-normalized attack waves, escalating by phase (§wave tuning).
        V3SetWaveTargets(player, c_TU_Marine, 10, V3WaveSupplyForPhase(phase), 6);
        V3SetWaveTargets(player, c_TU_Marauder, 20, V3WaveSupplyForPhase(phase), 6);
        V3SetWaveTargets(player, c_TU_SiegeTank, 30, V3WaveSupplyForPhase(phase), 6);
        // Medic is support: it follows the army (low minAlly) but never initiates.
        AISetAttackStatus(player, "SC2TeamMedic", 2, 999, c_continuousMerge);
    }
    else {
        V3TerranMechanicStock(player, phase);
        V3SetWaveTargets(player, "SC2TeamGoliath", 30, V3WaveSupplyForPhase(phase), 6);
        V3SetWaveTargets(player, c_TU_Cyclone, 30, V3WaveSupplyForPhase(phase), 6);
        V3SetWaveTargets(player, c_TU_SiegeTank, 30, V3WaveSupplyForPhase(phase), 6);
        V3SetWaveTargets(player, c_TU_Thor, 60, V3WaveSupplyForPhase(phase), 6);
    }
    V3BuildProactiveSupply(player, c_TB_SupplyDepot);
    AIDefaultEconomy(
        player,
        c_TB_CommandCenter_Alias,
        c_TB_Refinery,
        c_TB_SupplyDepot,
        c_TU_SCV,
        V3MiningWorkerCapacity(player),
        c_stockAlways
    );
    V3SetExpansionGasPolicy(player, c_TB_CommandCenter_Alias, c_TB_Refinery);
    V3SetMiningWorkerStock(player, c_TU_SCV);
    V3EnsureMiningExpansion(player, c_TB_CommandCenter_Alias, c_TB_CommandCenter, 400, 6);
    AIEnableStock(player);
    V3SetGasWorkerDistribution(player, c_TB_CommandCenter_Alias, c_TB_Refinery);
    return true;
}

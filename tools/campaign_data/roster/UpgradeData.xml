    <CUpgrade id="SC2TeamRaptorEvolution">
        <Race value="Zerg"/>
        <Icon value="Assets\Textures\btn-unit-zerg-zergling-raptor.dds"/>
        <EffectArray Operation="Add" Reference="Unit,Zergling,LifeMax" Value="10"/>
        <EffectArray Operation="Add" Reference="Unit,Zergling,LifeStart" Value="10"/>
        <EffectArray Operation="Add" Reference="Unit,Zergling,Speed" Value="0.5"/>
        <EffectArray Operation="Add" Reference="Effect,Claws,Amount" Value="2"/>

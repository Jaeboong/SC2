        <AffectedUnitArray value="ZerglingBurrowed"/>
        <Alert value="ResearchComplete"/>
        <Flags index="TechTreeCheat" value="1"/>
    </CUpgrade>
    <!-- §63: 멜레 무기/방어 업그레이드는 효과·유닛을 ID로 하나하나 참조하므로
         새 로스터 ID(SC2Team*)에는 아무것도 적용되지 않고, 적용이 없으니 유닛
         정보 패널의 +N 표기도 나오지 않는다. 아래 부분 오버라이드는 멜레
         업그레이드 레코드에 로스터 참조를 덧붙인다. 수치는 블리자드 캠페인이
         원본 골리앗/프레데터에 준 값 그대로다(지상 +1, 공중 미사일 발당 +2,
         프레데터 +2, 방어 +1). HotSTorrasque의 무기(KaiserBlades)는 멜레
         울트라리스크와 공유라 무기 업그레이드는 이미 적용되며 방어만 빠져 있다. -->

<?xml version='1.0' encoding='utf-8'?>
<Catalog>
    <CActorUnit id="Zealot">
        <Model value="SC2TeamZealotNerazimModel" />
        <On Terms="Behavior.ShadowCharging.Create" Send="AnimGroupApply Spell" />
        <On Terms="Behavior.ShadowCharging.Destroy" Send="AnimGroupRemove Spell" />
        <On Terms="Behavior.ShadowCharging.On" Send="ModelSuddenMotionStart" />
        <On Terms="Behavior.ShadowCharging.Off" Send="ModelSuddenMotionStop" />
        <UnitIcon value="Assets\Textures\btn-unit-protoss-zealot-nerazim.dds" />
        <!-- §115: ZealotShakuras 원본 액터와 같은 링크. -->
        <DeathArray index="Normal" ModelLink="SC2TeamZealotNerazimDeathModel" SoundLink="Zealot_DeathFX" />
        <BuildModel value="SC2TeamZealotNerazimWarpInModel" />
        <PortraitModel value="SC2TeamZealotNerazimPortraitModel" />
        <PlacementModel value="SC2TeamZealotNerazimPlacementModel" />
        <HeroIcon value="Assets\Textures\btn-unit-protoss-zealot-nerazim.dds" />
        <Wireframe>
            <Image value="Assets\Textures\wireframe-protoss-zealot-nerazim.dds" />
        </Wireframe>
        <GroupIcon>
            <Image value="Assets\Textures\wireframe-protoss-zealot-nerazim.dds" />
        </GroupIcon>
        <WireframeShield>
            <Image value="Assets\Textures\wireframe-protoss-zealot-nerazim-shield01.dds" />
            <Image value="Assets\Textures\wireframe-protoss-zealot-nerazim-shield02.dds" />
            <Image value="Assets\Textures\wireframe-protoss-zealot-nerazim-shield03.dds" />
        </WireframeShield>
    </CActorUnit>
    <CActorUnit id="Immortal">
        <Model value="SC2TeamImmortalNerazimModel" />
        <!-- §115: ImmortalShakuras 원본 액터와 같은 링크.  보호막 껍데기
             (ImmortalOverload = ImmortalShield.m3)는 부족 변형이 원본에 존재하지 않아
             기본 것을 그대로 쓴다 — 대신 위 모델의 0.75 스케일 복원으로 몸-껍데기
             크기 관계를 원본과 같게 맞췄다. -->
        <DeathArray index="Normal" ModelLink="SC2TeamImmortalNerazimDeathModel" SoundLink="" />
        <BuildModel value="SC2TeamImmortalNerazimWarpInModel" />
        <PortraitModel value="SC2TeamImmortalNerazimPortraitModel" />
        <PlacementModel value="SC2TeamImmortalNerazimPlacementModel" />
        <UnitIcon value="Assets\Textures\BTN-Unit-Protoss-Immortal-Nerazim.dds" />
        <Wireframe>
            <Image value="Assets\Textures\wireframe-protoss-immortal-nerazim.dds" />
        </Wireframe>
        <GroupIcon>
            <Image value="Assets\Textures\wireframe-protoss-immortal-nerazim.dds" />
        </GroupIcon>
        <WireframeShield>
            <Image value="Assets\Textures\Wireframe-Protoss-Immortal-Nerazim-Shield01.dds" />
            <Image value="Assets\Textures\Wireframe-Protoss-Immortal-Nerazim-Shield02.dds" />
            <Image value="Assets\Textures\Wireframe-Protoss-Immortal-Nerazim-Shield03.dds" />
        </WireframeShield>
    </CActorUnit>
    <CActorModel id="VoidZealotShadowCharge" parent="ModelAnimationStyleContinuous">
        <On Terms="Behavior.ShadowCharging.On" Send="Create" />
        <On Terms="ActorCreation" Send="SetOpacity 0.400000" />
        <On Terms="Behavior.ShadowCharging.Off" Send="AnimBracketStop BSD" />
        <Host Subject="_Unit" />
        <HostSiteOps Ops="SOpAttachCenter" />
        <Model value="ZealotShadowCharge" />
    </CActorModel>
    <CActorMissile id="ImmortalShakurasShadowCannonAttackMissile" parent="GenericAttackMissileWithDeathAnim" unitName="ImmortalShakurasShadowCannonMissile" />
    <CActorAction id="ImmortalShakurasShadowCannonAttack" parent="GenericAttack" effectImpact="ImmortalShakurasShadowCannonDamage" effectLaunch="ImmortalShakurasShadowCannonLM">
        <LaunchAttachQuery Methods="AMPatternImmortalShakuras" />
        <ImpactMap index="None" Sound="ImmortalShakuras_ShadowCannon_AttackImpact" />
    </CActorAction>
    <CActorRange id="DarkArchonMindControlRange" parent="RangeAbil" abil="DarkArchonMindControl" />
    <CActorBeamSimple id="DarkArchonMindControlBeam" parent="BeamSimpleAnimationStyleOneShot">
        <On Terms="Effect.DarkArchonMindControlApply.Start" Send="Create" />
        <HostLaunch Subject="_Unit" Scope="Caster" Actor="Find" />
        <HostLaunchSiteOps Ops="SOpAttachHead" />
        <HostImpact Subject="_Unit" Scope="Target" Actor="Find" />
        <HostImpactSiteOps Ops="SOpAttachHead" />
    </CActorBeamSimple>
    <CActorSound id="DarkArchonMindControlSound" parent="SoundOneShot">
        <On Terms="Behavior.DarkArchonMindControl.On" Send="Create" />
    </CActorSound>
    <CActorModel id="DarkArchonMindControlState" parent="ModelAnimationStyleContinuous">
        <On Terms="Behavior.DarkArchonMindControl.On" Send="Create" />
        <On Terms="Behavior.DarkArchonMindControl.On" Target="::Main" Send="SetSoundSuffix _MC" />
        <On Terms="Behavior.DarkArchonMindControl.On" Target="::Main" Send="PlayUnitSound Ready" />
        <On Terms="Behavior.DarkArchonMindControl.Off" Target="::Main" Send="SetSoundSuffix" />
        <On Terms="Behavior.DarkArchonMindControl.Off" Send="Destroy" />
        <Host Subject="_Unit" />
        <HostSiteOps Ops="SOpAttachCenter" />
        <ModelFlags index="AutomateGlobalLoops" value="1" />
    </CActorModel>
    <CActorRange id="DarkArchonConfusionRange" parent="RangeAbil" abil="DarkArchonConfusion" />
    <CActorSplat id="DarkArchonConfusionCursorSplat" parent="ProtossCursorSplat" abil="DarkArchonConfusion" />
    <CActorModel id="DarkArchonConfusionModel" parent="ModelAnimationStyleContinuous">
        <On Terms="Behavior.DarkArchonConfusion.On" Send="Create" />
        <On Terms="Behavior.DarkArchonConfusion.Off" Send="Destroy" />
        <On Terms="ActorOrphan" Send="Destroy" />
        <Host Subject="_Selectable" />
        <HostSiteOps Ops="SOpAttachOverhead" />
    </CActorModel>
    <CActorModel id="DarkArchonConfusionCastImpactModel" parent="ModelAnimationStyleOneShot">
        <On Terms="Effect.DarkArchonConfusionSearch" Send="Create" />
    </CActorModel>
    <CActorModel id="DarkArchonConfusionCastModel" parent="ModelAnimationStyleOneShot">
        <HostSiteOps Ops="SOpAttachWeapon" />
    </CActorModel>
    <CActorSound id="DarkArchonConfusionImpactActorSound" parent="SoundOneShot">
        <On Terms="Effect.DarkArchonConfusionSearch" Send="Create" />
    </CActorSound>
</Catalog>
    <CActorBeamSimple id="TargetLockLaserBeam" parent="BeamSimpleAnimationStyleContinuous">
        <On Terms="Effect.ObserverTargetLockCP.Start; At Target" Send="Create" />
        <On Terms="Effect.ObserverTargetLockCP.Stop" Send="AnimBracketStop BSD" />
        <On Terms="Effect.DarkArchonMindControlRemoveTargetLock.Start; At Target" Send="AnimBracketStop BSD" />
        <On Terms="ActorCreation" Send="Create SentryMonitor_TargetLock_Loop_ActorSound" />
        <HostLaunchSiteOps Ops="SOpAttachWeapon" />
        <HostImpactSiteOps Ops="SOpAttachCenter" />
        <HostLaunch Subject="_Unit" Scope="Caster" />
        <HostImpact Subject="_Unit" Scope="Target" />
        <Inherits index="Visibility" value="1" />
        <HostForProps Subject="_Unit" Scope="Caster" Actor="Find" />
        <ModelFlags index="AutomateGlobalLoops" value="1" />
    </CActorBeamSimple>
    <CActorSound id="SentryMonitor_TargetLock_Ping_ActorSound" parent="SoundOneShot">
        <On Terms="Behavior.ObserverTargetLock.On; ValidateUnit TargetLockUnitRadiusLarge" Send="Create" />

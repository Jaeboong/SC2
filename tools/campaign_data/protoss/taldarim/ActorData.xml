    <CActorRange id="ObserverTargetLockRange" parent="RangeAbil" abil="ObserverTargetLock" />
    <CActorModel id="TargetLockAttachment" parent="ModelAnimationStyleContinuous">
        <On Terms="Behavior.ObserverTargetLock.On; ValidateUnit TargetLockUnitRadiusSmall" Send="Create" />
        <On Terms="Behavior.ObserverTargetLock.Off" Send="AnimBracketStop BSD" />
        <HostSiteOps Ops="SOpAttachCenter" HoldRotation="1" />
        <Inherits index="BaseModelScale" value="1" />
        <Inherits index="Scale" value="1" />
        <Inherits index="Visibility" value="1" />
        <Host Subject="_Selectable" />
        <ModelFlags index="AutomateGlobalLoops" value="1" />
        <AutoScaleFactor value="0.700000" />
    </CActorModel>
    <CActorModel id="TargetLockAttachmentLarge" parent="ModelAnimationStyleContinuous">
        <On Terms="Behavior.ObserverTargetLock.On; ValidateUnit TargetLockUnitRadiusLarge" Send="Create" />
        <On Terms="Behavior.ObserverTargetLock.Off" Send="AnimBracketStop BSD" />
        <HostSiteOps Ops="SOpAttachCenter" HoldRotation="1" />

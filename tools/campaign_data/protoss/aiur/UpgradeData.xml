        <EffectArray Operation="Set" Reference="Weapon,SolariteReaper,Icon" Value="Assets\Textures\btn-upgrade-protoss-groundweaponslevel2.dds"/>
        <EffectArray Operation="Set" Reference="Weapon,Dragoon,Icon" Value="Assets\Textures\btn-upgrade-protoss-groundweaponslevel2.dds"/>
    </CUpgrade>

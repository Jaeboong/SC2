<?xml version='1.0' encoding='utf-8'?>
<Catalog>
    <!-- §115: ZealotPurifier / StalkerPurifier 원본 액터와 같은 링크로 죽음·소환·
         초상화·와이어프레임·아이콘을 채운다.  정화자 광전사의 죽음 모델은 이 카탈로그에
         이미 있는 ZealotPurifierDeath 를 재사용한다(부활 시체용으로 정의돼 있다).
         정화자 추적자의 소환·배치는 원본도 표준 StalkerWarpIn/StalkerPlacement 다. -->
    <CActorUnit id="Zealot">
        <Model value="SC2TeamZealotPurifierModel" />
        <DeathArray index="Normal" ModelLink="ZealotPurifierDeath" SoundLink="Zealot_DeathFX" />
        <BuildModel value="SC2TeamZealotPurifierWarpInModel" />
        <PortraitModel value="SC2TeamZealotPurifierPortraitModel" />
        <PlacementModel value="SC2TeamZealotPurifierPlacementModel" />
        <UnitIcon value="Assets\Textures\btn-unit-protoss-zealot-purifier.dds" />
        <Wireframe>
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier.dds" />
        </Wireframe>
        <GroupIcon>
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier.dds" />
        </GroupIcon>
        <WireframeShield>
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier-shield01.dds" />
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier-shield02.dds" />
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier-shield03.dds" />
        </WireframeShield>
    </CActorUnit>
    <CActorUnit id="Stalker">
        <Model value="SC2TeamStalkerPurifierModel" />
        <DeathArray index="Normal" ModelLink="SC2TeamStalkerPurifierDeathModel" SoundLink="" />
        <PortraitModel value="SC2TeamStalkerPurifierPortraitModel" />
        <UnitIcon value="Assets\Textures\BTN-Unit-Protoss-Stalker-Purifier.dds" />
        <HeroIcon value="Assets\Textures\BTN-Unit-Protoss-Stalker-Purifier.dds" />
        <Wireframe>
            <Image value="Assets\Textures\Wireframe-Protoss-Stalker-Purifier.dds" />
        </Wireframe>
        <GroupIcon>
            <Image value="Assets\Textures\Wireframe-Protoss-Stalker-Purifier.dds" />
        </GroupIcon>
        <WireframeShield>
            <Image value="Assets\Textures\Wireframe-Protoss-Stalker-Purifier-Shield01.dds" />
            <Image value="Assets\Textures\Wireframe-Protoss-Stalker-Purifier-Shield02.dds" />
            <Image value="Assets\Textures\Wireframe-Protoss-Stalker-Purifier-Shield03.dds" />
        </WireframeShield>
    </CActorUnit>
    <CActorSound id="SentryPhasingModeSound" parent="SoundOneShot">
        <On Terms="AbilMorph.*.Start; MorphTo SentryPhasing" Send="Create" />
        <Sound value="SentryPurifier_PhaseMode_On" />
    </CActorSound>
    <CActorModel id="SentryWarpPrismAddition" parent="ModelAddition">
        <HostSiteOps Ops="SOpAttachCenter SOpUpsideDown SOpMoveUpByDot15" />
        <ModelFlags index="AllowHitTest" value="0" />
        <On Terms="AbilMorph.*.Start; MorphTo SentryPhasing" Send="AnimBracketStart Work Stand,Work,Start Stand,Work Stand,Work,End" />
        <On Terms="AbilMorph.*.Start; MorphTo SentryPurifier" Send="AnimBracketStop Work" />
    </CActorModel>
    <CActorUnit id="SentryPhasing" parent="GenericUnitStandard" unitName="SentryPhasing">
        <PortraitModel value="SentryPurifierPortrait" />
        <On Terms="UnitHeightUpdate.*.Land" Send="Create Sentry_Land" />
        <On Terms="UnitBirth.SentryPhasing" Send="AnimBracketStart Work {} Stand,Work,A Stand,Work,End,A Instant" />
        <On Terms="AbilMorph.*.Finish; MorphFrom SentryPurifier; MorphTo SentryPhasing" Send="AnimBracketStart Work {} Stand,Work,A Stand,Work,End,A Instant" />
        <On Terms="AbilMorph.*.Start; MorphFrom SentryPhasing; MorphTo SentryPurifier" Send="AnimBracketStop Work" />
        <On Terms="AbilMorph.*.Finish; MorphTo SentryPhasing" Send="Create" />
        <On Terms="AbilMorph.*.Finish; MorphFrom SentryPhasing" Send="Destroy" />
        <DeathArray index="Normal" ModelLink="SentryPurifierDeath" SoundLink="Energizer_Explode" />
        <BarWidth value="50" />
        <BarOffset value="40" />
        <UnitIcon value="Assets\Textures\btn-unit-protoss-sentry-purifier.dds" />
        <HeroIcon value="Assets\Textures\btn-unit-protoss-sentry-purifier.dds" />
        <WireframeShield>
            <Image value="Assets\Textures\wireframe-protoss-sentry-purifier-phasemode-shield01.dds" />
            <Image value="Assets\Textures\wireframe-protoss-sentry-purifier-phasemode-shield02.dds" />
            <Image value="Assets\Textures\wireframe-protoss-sentry-purifier-phasemode-shield03.dds" />
        </WireframeShield>
        <GroupIcon>
            <Image value="Assets\Textures\wireframe-protoss-sentry-purifier-phasemode.dds" />
        </GroupIcon>
        <Wireframe>
            <Image value="Assets\Textures\wireframe-protoss-sentry-purifier-phasemode.dds" />
        </Wireframe>
        <LifeArmorIcon value="Assets\Textures\btn-upgrade-protoss-groundarmorlevel0.dds" />
        <HostSiteOps Ops="SOpBankerSentry" />
        <SoundArray index="Ready" value="Energizer_Ready" />
        <SoundArray index="What" value="Energizer_What" />
        <SoundArray index="Yes" value="Energizer_Yes" />
        <SoundArray index="Attack" value="Energizer_Attack" />
        <SoundArray index="Pissed" value="Energizer_Pissed" />
    </CActorUnit>
    <CActorSound id="SentryChronoBeamSoundStart" parent="SoundOneShot">
        <Sound value="SentryPurifier_ChronoBeam" />
        <On Terms="Effect.VoidSentryChronoBeamCP.Start; At Target" Send="Create" />
        <On Terms="ActorOrphan" Send="Destroy" />
        <Host Subject="_Selectable" />
        <HostSiteOps Ops="SOpAttachOverhead" />
    </CActorSound>
    <CActorSound id="SentryChronoBeamSoundLoop" parent="SoundContinuous">
        <Sound value="SentryPurifier_ChronoBeam_Loop" />
        <On Terms="Effect.VoidSentryChronoBeamCP.Stop; At Target" Send="Destroy" />
        <On Terms="ActorOrphan" Send="Destroy" />
        <Host Subject="_Selectable" />
        <HostSiteOps Ops="SOpAttachOverhead" />
    </CActorSound>
    <CActorBeamSimple id="SentryChronoBeamBeam" parent="BeamSimpleAnimationStyleContinuous">
        <On Terms="Effect.VoidSentryChronoBeamCP.Start" Send="Create" />
        <On Terms="Effect.VoidSentryChronoBeamCP.Stop" Send="AnimBracketStop BSD" />
        <HostForProps Subject="_Unit" Scope="Caster" Actor="Find" />
        <HostLaunch Subject="_Unit" Scope="Caster" Actor="Find" />
        <HostImpact Subject="_Unit" Scope="Target" Actor="Find" />
        <HostLaunchSiteOps Ops="SOpAttachCenter" />
        <HostImpactSiteOps Ops="SOpAttachCenter" />
        <Inherits index="Visibility" value="1" />
        <ModelFlags index="AutomateGlobalLoops" value="1" />
    </CActorBeamSimple>
    <CActorModel id="SentryChronoBeamImpact" parent="ModelAnimationStyleContinuous">
        <AutoScaleFactor value="0.600000" />
        <Host Subject="_Unit" />
        <HostSiteOps Ops="SOpAttachOrigin" />
        <On Terms="Behavior.VoidSentryChronoBeam.On" Send="Create" />
        <On Terms="Behavior.VoidSentryChronoBeam.Off" Send="AnimBracketStop BSD" />
        <ModelFlags index="AllowHitTest" value="0" />
        <ModelFlags index="AutomateGlobalLoops" value="1" />
    </CActorModel>
    <CActorUnit id="ZealotPurifierReviveCorpse" parent="GenericUnitMorph" unitName="ZealotPurifierReviveCorpse">
        <On Terms="ActorCreation" Send="TimerSet 5.000000 DelayGlaze" />
        <On Terms="TimerExpired; TimerName DelayGlaze" Send="Create GlazeSentinelRepair" />
        <On Terms="AbilMorph.*.Finish; MorphTo ZealotPurifierReviveCorpse" Send="$Birth" />
        <On Terms="AnimDone; AnimName Birth" Send="AnimPlay Work Death PlayForever" />
        <DeathArray index="Normal" ModelLink="ZealotPurifierDeath" SoundLink="Zealot_DeathFX" />
        <PortraitModel value="ZealotPurifierPortrait" />
        <BarWidth value="42" />
        <BarOffset value="45" />
        <UnitIcon value="Assets\Textures\btn-unit-protoss-zealot-purifier.dds" />
        <HeroIcon value="Assets\Textures\btn-unit-protoss-zealot.dds" />
        <LifeArmorIcon value="Assets\Textures\btn-upgrade-protoss-groundarmorlevel0.dds" />
        <SoundArray index="Birth" value="Zealot_Birth" />
        <SoundArray index="Ready" value="Zealot_Ready" />
        <SoundArray index="Help" value="Zealot_Help" />
        <SoundArray index="Yes" value="Zealot_Yes" />
        <SoundArray index="Attack" value="Zealot_Attack" />
        <SoundArray index="Pissed" value="Zealot_Pissed" />
        <WireframeShield>
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier-shield01.dds" />
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier-shield02.dds" />
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier-shield03.dds" />
        </WireframeShield>
        <GroupIcon>
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier.dds" />
        </GroupIcon>
        <Wireframe>
            <Image value="Assets\Textures\wireframe-protoss-zealot-purifier.dds" />
        </Wireframe>
        <Aliases value="_UnitSmall" />
    </CActorUnit>
    <CActorModel id="ZealotPurifierReviveWreckageExplosion" parent="ModelAddition">
        <Remove Terms="ActorCreation" Send="AnimBracketStart BSD Birth Stand Death" />
        <On Terms="ActorCreation" Send="$Death" />
        <On Terms="AnimDone; AnimName Death" Send="Destroy" />
        <Host Subject="_Unit" />
        <HostSiteOps Ops="SOpAttachOrigin" />
        <Model value="ZealotPurifierDeath" />
    </CActorModel>
</Catalog>
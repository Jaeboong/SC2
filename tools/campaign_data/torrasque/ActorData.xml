<?xml version="1.0" encoding="utf-8"?>
<Catalog>
  <CActorUnit id="HotSTorrasque" parent="GenericUnitBase" unitName="HotSTorrasque">
    <ShieldArmorIcon value="Assets\Textures\btn-upgrade-zerg-swarmfrenzy.dds" />
    <StatusColors index="Shields">
      <ColorArray index="0" value="255,0,128,0" />
    </StatusColors>
    <VitalColors index="Shields">
      <ColorArray value="255,0,128,0" />
    </VitalColors>
    <VitalNames index="Shields" value="Vital/ZergShields" />
    <WireframeShieldColor value="255,0,128,0" />
    <!--On Terms="ActorCreation" Send="SetTintColor 128,128,255"/-->
    <ModelFlags index="AutomateGlobalLoops" value="0" />
    <On Terms="UnitBirth.HotSTorrasqueBurrowed" Send="Create" />
    <On Terms="UnitBirth.HotSTorrasqueBurrowed" Send="AnimBracketStart Burrow Burrow IGNORE Unburrow ClosingFull,OpeningPlayForever,Instant" />
    <On Terms="Abil.attack.ReadyStart" Send="AnimGroupApply Ready" />
    <On Terms="WeaponStart.KaiserBlades.AttackStart; !ValidateUnit HaveHotSMonarchBlades" Send="AnimPlay Attack Spell,A" />
    <On Terms="WeaponStart.KaiserBlades.AttackStart; ValidateUnit HaveHotSMonarchBlades" Send="AnimPlay Attack Spell,D" />
    <On Terms="WeaponStop.KaiserBlades.AttackStop" Send="AnimClear Attack" />
    <On Terms="Abil.attack.ReadyStop" Send="AnimGroupRemove Ready" />
    <On Terms="AbilMorph.*.Start; AbilKey BurrowDown" Send="Create BurrowDownUltralisk" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasque; !AbilKey BurrowUp" Send="Create" />
    <On Terms="AbilMorph.*.Start; MorphTo TorrasqueCorpse" Send="Destroy" />
    <On Terms="WeaponStart.KaiserBlades.AttackStart" Send="AnimClear BurrowChargeUp" />
    <On Terms="UnitMovementUpdate.*.Walk" Send="AnimClear BurrowChargeUp" />
    <On Terms="UnitBirth.HotSTorrasque" Send="TerrainSquibActivateGroup RippleStandard" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasque" Send="TerrainSquibActivateGroup RippleStandard" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasqueBurrowed" Send="TerrainSquibDeactivate" />
    <On Terms="AbilMorph.*.Cancel; MorphFrom HotSTorrasque; MorphTo HotSTorrasqueBurrowed" Send="AnimClear Burrow" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasque; MorphFrom HotSTorrasqueBurrowed" Send="AnimBracketStop Burrow" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasque; MorphFrom HotSTorrasqueBurrowed" Send="AnimClear Burrow" />
    <On Terms="Behavior.TorrasqueDontDie.On" Send="AnimBracketStart DontDie GLbirth GLstand IGNORE" />
    <On Terms="Behavior.TorrasqueDontDie.Off" Send="AnimBracketStop DontDie" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasque; MorphFrom TorrasqueChrysalis" Send="SetScale 0.200000" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasque; MorphFrom TorrasqueChrysalis" Send="SetScale 1.000000 0.400000" />
    <On Terms="AbilMorph.*.Finish; MorphTo HotSTorrasque; MorphFrom TorrasqueChrysalis" Send="$Birth 0 0.000000 0.250000" />
    <On Terms="UnitMovementUpdate.*.Walk; AnimPlaying Birth" Send="AnimClear Birth" />
    <!-- Burrow charge, campaign version -->
    <On Terms="ActorCreation" Send="StatusSet BurrowCharging 0" />
    <On Terms="ActorCreation" Send="TimerSet 0.070000 BurrowChargeFX" />
    <On Terms="TimerExpired; TimerName BurrowChargeFX; IsStatus BurrowCharging 1; !ModelIsLowQuality" Send="Create UltraliskBurrowChargeModel" />
    <On Terms="TimerExpired; TimerName BurrowChargeFX" Send="TimerSet 0.070000 BurrowChargeFX" />
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="AnimClear Fidget" />
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="AnimBaselineStop" />
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="AnimPlay BurrowChargeDown Burrow" />
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="AnimPlay Burrow Walk,Burrow PlayForever" />
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="Create BurrowChargeDownSound" />
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="TimerSet 0.500000 BurrowChargingState" />
    <On Terms="TimerExpired; TimerName BurrowChargingState" Send="StatusSet BurrowCharging 1" />
    <!-- Cast has a .5 second delay, if the ultra can no longer get to the target during this time it would stay underground -->
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="TimerSet 0.600000 ChargeFailTimer" />
    <On Terms="Abil.UltraliskBurrowCharge.SourceCastStart" Send="StatusSet ChargeFail 1" />
    <On Terms="Behavior.BurrowCharging.On" Send="StatusSet ChargeFail 0" />
    <On Terms="TimerExpired; TimerName ChargeFailTimer; IsStatus ChargeFail 1" Send="AnimClear Burrow" />
    <On Terms="TimerExpired; TimerName ChargeFailTimer; IsStatus ChargeFail 1" Send="AnimClear BurrowChargeDown" />
    <On Terms="TimerExpired; TimerName ChargeFailTimer; IsStatus ChargeFail 1" Send="AnimPlay BurrowChargeUp Stand,Cover" />
    <On Terms="TimerExpired; TimerName ChargeFailTimer; IsStatus ChargeFail 1" Send="AnimBaselineStart" />
    <On Terms="TimerExpired; TimerName ChargeFailTimer; IsStatus ChargeFail 1" Send="Create BurrowChargeUpSound" />
    <On Terms="TimerExpired; TimerName ChargeFailTimer; IsStatus ChargeFail 1" Send="StatusSet BurrowCharging 0" />
    <On Terms="Effect.BurrowChargeTargetSearch.Start; At Caster" Send="AnimClear Burrow" />
    <On Terms="Effect.BurrowChargeTargetSearch.Start; At Caster" Send="AnimClear BurrowChargeDown" />
    <On Terms="Effect.BurrowChargeTargetSearch.Start; At Caster" Send="AnimPlay BurrowChargeUp Spell,C" />
    <On Terms="Effect.BurrowChargeTargetSearch.Start; At Caster" Send="AnimBaselineStart" />
    <On Terms="Effect.BurrowChargeTargetSearch.Start; At Caster" Send="Create BurrowChargeUpSound" />
    <On Terms="Effect.BurrowChargeTargetSearch.Start; At Caster" Send="StatusSet BurrowCharging 0" />
    <On Terms="Effect.BurrowChargeStructureTargetSearch.Start; At Caster" Send="AnimClear Burrow" />
    <On Terms="Effect.BurrowChargeStructureTargetSearch.Start; At Caster" Send="AnimClear BurrowChargeDown" />
    <On Terms="Effect.BurrowChargeStructureTargetSearch.Start; At Caster" Send="AnimPlay BurrowChargeUp Spell,C" />
    <On Terms="Effect.BurrowChargeStructureTargetSearch.Start; At Caster" Send="AnimBaselineStart" />
    <On Terms="Effect.BurrowChargeStructureTargetSearch.Start; At Caster" Send="Create BurrowChargeUpSound" />
    <On Terms="Effect.BurrowChargeStructureTargetSearch.Start; At Caster" Send="StatusSet BurrowCharging 0" />
    <On Terms="WeaponStart.KaiserBlades.AttackStart" Send="AnimClear BurrowChargeUp" />
    <On Terms="UnitMovementUpdate.*.Walk" Send="AnimClear BurrowChargeUp" />
    <On Terms="UnitHeightUpdate.*.Land" Send="Create Ultra_Land" />
    <On Terms="UnitMovementUpdate.*.Walk; AnimPlaying Birth" Send="AnimClear Birth" />
    <PortraitModel value="TorrasquePortrait" />
    <DeathArray index="Normal" ModelLink="UltraliskEx1BDeath" SoundLink="Ultralisk_Explode" VoiceLink="" />
    <!--DeathArray index="Disintegrate" ModelLink="UltraliskDeathAcid" SoundLink="Uni_DeathFXAcid"/>
        <DeathArray index="Fire" ModelLink="UltraliskDeathFire" SoundLink="Uni_DeathFXFireLarge"/-->
    <AnimBlendTime value="0.300000" />
    <Macros value="ZergBurrowStandardAnimMacro" />
    <Macros value="ZergLargeBurrowEffects" />
    <Macros value="UnloadDropAnim" />
    <Macros value="TerrainSquibAnimations" />
    <EventDataSound Name="UltraliskAttack" Actor="UnitSound" Sound="Ultralisk_AttackLaunch" />
    <EventDataSound Name="UltraliskHeadAttack" Actor="UnitSound" Sound="Ultralisk_HeadAttackImpact" />
    <WalkAnimMoveSpeed value="2.9375" />
    <BarWidth value="160" />
    <BarOffset value="30" />
    <NameOffset value="40" />
    <SoundArray index="Birth" value="Ultralisk_Birth" />
    <SoundArray index="Ready" value="Ultralisk_Ready" />
    <SoundArray index="Help" value="Ultralisk_Help" />
    <SoundArray index="What" value="Ultralisk_What" />
    <SoundArray index="Yes" value="Ultralisk_Yes" />
    <SoundArray index="Attack" value="Ultralisk_Attack" />
    <SoundArray index="Pissed" value="Ultralisk_Pissed" />
    <SoundArray index="Movement" value="Ultralisk_Movement" />
    <UnitIcon value="Assets\Textures\btn-unit-zerg-ultralisk-torrasque.dds" />
    <HeroIcon value="Assets\Textures\btn-unit-zerg-ultralisk-torrasque.dds" />
    <GroupIcon>
      <Image value="Assets\Textures\Wireframe-Zerg-ultraliskex1b.dds" />
    </GroupIcon>
    <Wireframe>
      <Image value="Assets\Textures\Wireframe-Zerg-ultraliskex1b.dds" />
    </Wireframe>
    <LifeArmorIcon value="Assets\Textures\btn-upgrade-zerg-groundcarapace-level0.dds" />
    <TerrainSquibs>
      <GroupName value="RippleStandard" />
      <MovementDistance value="0.150000,0.150000" />
      <IdlePeriod value="0.100000,0.250000" />
      <RangeUp value="2.000000" />
      <RangeDown value="2.000000" />
      <AttachQuery Methods="AMFilterCenter" />
      <Visuals TerrainPhysicsMaterial="Water" ActorModel="TerrainSquibHarnessContinuous" ModelLink="WaterRippleUltralisk" />
    </TerrainSquibs>
    <Aliases value="_UnitHuge" />
  </CActorUnit>
  <CActorAction id="HotSTorrasqueAttack" parent="GenericAttack" effectLaunch="TorrasqueKaiserBladesDamage">
    <ShieldFlashType value="Header" />
  </CActorAction>
